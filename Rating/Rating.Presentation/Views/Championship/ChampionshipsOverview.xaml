<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
    xmlns:overview="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Overview;assembly=Rating.Application"
    xmlns:events="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Events;assembly=Rating.Application">
    <ResourceDictionary.MergedDictionaries>
        <!--<ResourceDictionary Source="../../RatingPresentation.xaml" />-->
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type events:NextEventToolbarViewModel}">
                <Grid Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border BorderBrush="{StaticResource Anthracite03Brush}" BorderThickness="2" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StandardText}" FontWeight="Bold"
                                               Text="Next Event: " />
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding ChampionshipName}" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding Track}" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding EventDate}" />
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding EventLength }" Margin="5,0,0,0" />
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Command="{Binding NextChampionshipCommand}"
                                        Style="{StaticResource StandardButton}">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource NextFrame}" Margin="-5" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>

                                <Button Grid.Row="1" Command="{Binding RandomChampionshipCommand}"
                                        Style="{StaticResource StandardButton}">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-5">
                                            <ContentPresenter Content="{StaticResource RandomIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>

                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type overview:NextRaceOverviewViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Vertical" Grid.Column="0">
                        <TextBlock Style="{StaticResource StandardText}"
                                   Text="Please use these settings for the next race:"
                                   FontSize="{StaticResource BigFontSize}" Margin="10" />
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="250">
                        <ItemsControl ItemsSource="{Binding TextualRequirements}" Margin="15,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="5" Style="{StaticResource StandardText}" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Vertical"  HorizontalAlignment="Right">
                            <Button Command="{Binding RedFlagSessionCommand}"
                                    Visibility="{Binding IsDnfButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="Red Flags the session. The session will completed, position are kept, partial points are awarded.">
                                <Button.Content>
                                    <Grid Margin="2" Background="{StaticResource DarkRed01Brush}">
                                        <TextBlock Style="{StaticResource StandardText}" Text="Red Flag This Session." />
                                    </Grid>
                                </Button.Content>
                            </Button>
                        <Button Command="{Binding DnfSessionCommand}"
                                Visibility="{Binding IsDnfButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Forfeit last session. You will be moved to last place, full points will be awarded.">
                            <Button.Content>
                                <Grid Margin="2" Background="{StaticResource DarkRed01Brush}">
                                    <TextBlock Style="{StaticResource StandardText}" Text="DNF This Session." />
                                </Grid>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type overview:ChampionshipsOverviewViewModel}">
                <Grid Background="{StaticResource Anthracite01Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="{StaticResource ExtraBigFontSize}"
                        Style="{StaticResource StandardText}"
                        Text="Championships:" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Grid.Column="0" Padding="2">
                            <StackPanel Orientation="Vertical">
                                <Button Width="40" Height="40" Command="{Binding CreateNewCommand}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="Create New Championship.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource PlusIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Command="{Binding RemoveSelectedCommand}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="Remove Selected Championship.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource MinusIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Margin="0,30,0,0" Command="{Binding OpenSelectedCommand}"
                                                  Style="{StaticResource StandardButton}"
                                                  ToolTip="Open details for Selected Championship.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                            <ContentPresenter Content="{StaticResource DetailIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Margin="0,10,0,0" Command="{Binding ModifyLastResultCommand}"
                                        Style="{StaticResource StandardButton}"
                                        Visibility="{Binding IsModifyLastResultCommandVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="Manually modify the result of the last championship event.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                            <ContentPresenter Content="{StaticResource ModifyIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Margin="0,30,0,0" Command="{Binding ResetSelectedCommand}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="Resets the Selected.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2" >
                                            <ContentPresenter Content="{StaticResource ResetIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Command="{Binding SaveSelectedChampionshipCalendarCommand}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="Save the Calendar for the selected championship.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource SaveIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="40" Height="40" Command="{Binding ReRollMysteryPropertiesCommand}" Visibility="{Binding IsReRollButtonVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="ReRolls Random class / track for the current event.">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource RandomIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Column="1" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Grid.Row="0">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                            <ListBox Foreground="{StaticResource LightGrey01Brush}" Background="{StaticResource Anthracite01Brush}" MinWidth="800" SelectedItem="{Binding SelectedChampionship}"  ItemsSource="{Binding AllChampionships}" Grid.IsSharedSizeScope="True" Height="600">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="overview:ChampionshipOverviewViewModel">
                                        <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}">
                                            <Grid VerticalAlignment="Center" Background="Transparent">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChampSimNameSharedWidth"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChampPosSharedWidth"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChampNameSharedWidth"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChampClassSharedWidth"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="ChampNextSharedWidth"/>
                                                </Grid.ColumnDefinitions>

                                                        <wpf:ColorAbleIcon Margin="10" IsHitTestVisible="False"
                                                                   StrokeBrush="{Binding ChampionshipState, Converter={StaticResource ChampionshipStateToBrushConverter}}"
                                                                   RebindOnVisibilityChange="True">
                                                    <ContentPresenter Content="{StaticResource CircleLight2}" />
                                                </wpf:ColorAbleIcon>

                                                <StackPanel Orientation="Horizontal" Grid.Column="1" IsHitTestVisible="False">
                                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource DarkGrey01Brush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Margin="10" Style="{StaticResource StandardText}" VerticalAlignment="Center" Text="{Binding Simulator}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="3" Margin="10" Style="{StaticResource StandardText}" VerticalAlignment="Center" Text="{Binding Position}" IsHitTestVisible="False" />
                                                <TextBlock Grid.Column="4" Margin="10" Style="{StaticResource StandardText}" VerticalAlignment="Center" Text="{Binding Name}" IsHitTestVisible="False" />
                                                <StackPanel Orientation="Horizontal" Grid.Column="5" IsHitTestVisible="False">
                                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource DarkGrey01Brush}" IsHitTestVisible="False" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="6" Margin="10" Style="{StaticResource StandardText}" VerticalAlignment="Center" Text="{Binding ClassName}" IsHitTestVisible="False" />
                                                <StackPanel Orientation="Horizontal" Grid.Column="7" IsHitTestVisible="False">
                                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Background="{StaticResource DarkGrey01Brush}" IsHitTestVisible="False" />
                                                </StackPanel>
                                                <Grid Grid.Column="8">
                                                    <StackPanel Margin="10" Orientation="Vertical"
                                                                HorizontalAlignment="Left">
                                                        <TextBlock Style="{StaticResource StandardText}"
                                                                   VerticalAlignment="Center" Text="{Binding Progress}"
                                                                   IsHitTestVisible="False" />
                                                        <ScrollViewer MaxWidth="400"
                                                                      HorizontalAlignment="Left"
                                                                      HorizontalScrollBarVisibility="Auto"
                                                                      VerticalScrollBarVisibility="Hidden"
                                                                      Visibility="{Binding Remark, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                            <TextBlock Style="{StaticResource StandardText}"
                                                                       VerticalAlignment="Center"
                                                                       Text="{Binding Remark}"
                                                                       IsHitTestVisible="False" />
                                                        </ScrollViewer>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid.InputBindings>
                                                    <MouseBinding MouseAction="LeftDoubleClick"
                                                                  Command="{Binding DataContext.OpenSelectedCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" />
                                                </Grid.InputBindings>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            </ScrollViewer>
                        </Border>
                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource LightGrey01Brush}">
                                <ContentPresenter Content="{Binding NextRaceOverviewViewModel}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>
             <DataTemplate DataType="{x:Type overview:RestartChampionshipDialogViewModel}">
                <Grid Background="{StaticResource Anthracite01Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Do you want to restart the selected championship?" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" TextWrapping="WrapWithOverflow" Margin="50" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="1">
                        <Button Height="55" HorizontalAlignment="Right"
                                IsDefault="True"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding OkCommand}">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource OkIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Height="55" HorizontalAlignment="Right"
                                IsCancel="True"
                                ToolTip="Restart championships, and also shuffles the calendar."
                                Style="{StaticResource StandardButton}"
                                Command="{Binding ShuffleCommand}">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource RandomIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Height="55" HorizontalAlignment="Right"
                                IsCancel="True"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding CancelCommand}">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource CancelIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>