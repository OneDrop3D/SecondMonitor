<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overview="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Overview;assembly=Rating.Application"
                    xmlns:modifyResults="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Overview.ModifyResults;assembly=Rating.Application"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls">
    
    <DataTemplate DataType="{x:Type modifyResults:DriverResultViewModel}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DriversFinishName"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DriverTeamName"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DriverCarName"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="DriverFinishPoints"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="BestLapIcon"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Background="{StaticResource DarkGrey01Brush}">
                        <TextBox Style="{StaticResource StandardTextBox}" Width="32" FontSize="{StaticResource BigFontSize}" HorizontalAlignment="Center"  Text="{Binding FinishPosition, Converter={StaticResource NonNegativeIntToStringConverter}}"/>
                    </Grid>
                    <TextBlock Grid.Column="1" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="{Binding DriverName }" Margin="10,0,10,0"/>
                    <TextBlock Grid.Column="2" Visibility="{Binding IsCarNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="{Binding CarName }" Margin="10,0,10,0"/>
                    <TextBlock Grid.Column="3" Visibility="{Binding IsTeamNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="{Binding TeamName }" Margin="10,0,10,0"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="{Binding PointsGain, StringFormat=' {0} pts' }" Margin="10,0,10,0"/>
                    <Grid Grid.Column="5" Background="{StaticResource Anthracite02Brush}" Visibility="{Binding WasFastestLap, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <wpf:ColorAbleIcon Margin="2" Width="28"
                                           StrokeBrush="{StaticResource PurpleTimingBrush}">
                            <ContentPresenter Content="{StaticResource StopwatchIcon}" />
                        </wpf:ColorAbleIcon>
                    </Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Green01Brush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
            </DataTemplate>
    
    <DataTemplate DataType="{x:Type modifyResults:ModifyResultsWindowViewModel}">
        <Grid Background="{StaticResource Anthracite01Brush}">
            <Grid Background="{StaticResource Anthracite01Brush}" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MaxHeight="800" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="20" Visibility="{Binding Header, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource StandardText}" FontSize="36" HorizontalAlignment="Center" Text="{Binding Header}" />
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding DriverResultViewModels}" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                    <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                        <ContentPresenter Content="{Binding }" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2" Margin="0,5,30,30">
                    <Button Height="55" HorizontalAlignment="Right"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding OkCommand}">
                        <Button.Content>
                            <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                <ContentPresenter Content="{StaticResource OkIcon}" />
                            </wpf:ColorAbleIcon>
                        </Button.Content>
                    </Button>
                    <Button Height="55" HorizontalAlignment="Right"
                            Style="{StaticResource StandardButton}"
                            Command="{Binding CancelCommand}">
                        <Button.Content>
                            <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                <ContentPresenter Content="{StaticResource CancelIcon}" />
                            </wpf:ColorAbleIcon>
                        </Button.Content>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
            </DataTemplate>
</ResourceDictionary>