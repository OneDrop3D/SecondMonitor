<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:overview="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Overview;assembly=Rating.Application"
                    xmlns:events="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Events;assembly=Rating.Application"
                    xmlns:layouts="clr-namespace:SecondMonitor.WindowsControls.WPF.Layouts;assembly=WindowsControls"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../RatingPresentation.xaml" />
        <ResourceDictionary>
            
            <DataTemplate DataType="{x:Type events:DriversClassSessionResultViewModel}" x:Key="DriversClassSessionResultsWithoutScrollViewer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20" Visibility="{Binding Header, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource StandardText}" FontSize="36" HorizontalAlignment="Center" Text="{Binding Header}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DriversFinish}" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                    <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                        <ContentPresenter Content="{Binding }" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type events:DriversSessionResultViewModel}" x:Key="DriversSessionResultsWithoutScrollViewer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20" Visibility="{Binding Header, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource StandardText}" FontSize="36" HorizontalAlignment="Center" Text="{Binding Header}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding DriversFinish}" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                    <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                        <ContentPresenter Content="{Binding }" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type events:ManufacturersSessionResultViewModel}" x:Key="ManufacturersSessionResultsWithoutScrollViewer">
                <Grid Visibility="{Binding HasAnyResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20" Visibility="{Binding Header, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource StandardText}" FontSize="36" HorizontalAlignment="Center" Text="{Binding Header}"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding ManufacturerFinish}" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                    <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                        <ContentPresenter Content="{Binding }" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type events:TeamsSessionResultViewModel}" x:Key="TeamsSessionResultsWithoutScrollViewer">
                <Grid Visibility="{Binding HasAnyResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20" Visibility="{Binding Header, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource StandardText}" FontSize="36" HorizontalAlignment="Center" Text="{Binding Header}"/>
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding TeamsFinish}" VerticalAlignment="Top" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                    <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                        <ContentPresenter Content="{Binding }" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type events:SessionResultWithTitleViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Content="{Binding EventTitleViewModel}"/>
                        <Grid Grid.Column="1">
                        <Button VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,10" Command="{Binding AmendResults}"
                                Width="40"
                                Height="40"
                                Style="{StaticResource StandardButton}"
                                Visibility="{Binding AmendResults, Converter={StaticResource NotNullToVisibilityConverter}}"
                                ToolTip="Manually modify this result.">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="0">
                                    <ContentPresenter Content="{StaticResource ModifyIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        </Grid>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DockPanel>
                            <ContentPresenter Content="{Binding DriversSessionResultViewModel}" ContentTemplate="{StaticResource  DriversSessionResultsWithoutScrollViewer}" DockPanel.Dock="Top" />
                            <ItemsControl HorizontalContentAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding DriversClassSessionResultViewModels}" ItemTemplate="{StaticResource DriversClassSessionResultsWithoutScrollViewer}" DockPanel.Dock="Top"/>
                            <ItemsControl HorizontalContentAlignment="Center" HorizontalAlignment="Center" ItemsSource="{Binding TeamsSessionResultViewModels}" DockPanel.Dock="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl  HorizontalContentAlignment="Center" HorizontalAlignment="Center"  ItemsSource="{Binding ManufacturersSessionResultViewModels}" DockPanel.Dock="Top">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Style="{StaticResource StandardText}" HorizontalAlignment="Center" TextAlignment="Center"
                               Text="{Binding Remark}" Visibility="{Binding Remark, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type overview:ChampionshipSessionsResultsViewModel}">
                <Border BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1" Padding="10">
                    <layouts:ViewSequenceControl Views="{Binding ResultsHistory}" StartFromLast="True" Style="{StaticResource StandardSequenceStyle}" CloseButtonCommand="{Binding CloseCommand}"  />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
        </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>