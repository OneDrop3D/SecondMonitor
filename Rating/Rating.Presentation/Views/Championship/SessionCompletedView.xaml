<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:events="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Events;assembly=Rating.Application"
                    xmlns:layouts="clr-namespace:SecondMonitor.WindowsControls.WPF.Layouts;assembly=WindowsControls"
                    xmlns:viewModels="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels;assembly=Rating.Application"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
                    xmlns:statusIcon="clr-namespace:SecondMonitor.WindowsControls.WPF.StatusIcon;assembly=WindowsControls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../RatingPresentation.xaml" />
        <ResourceDictionary>

            <DataTemplate DataType="{x:Type viewModels:OpenLastResultPitBoardViewModel}">
                <Border BorderBrush="{StaticResource Green01Brush}" BorderThickness="5" CornerRadius="10" Padding="5" Background="{StaticResource Anthracite01Brush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Row="1">
                            <Button HorizontalAlignment="Stretch" Margin="5" HorizontalContentAlignment="Stretch"
                                    Command="{Binding OpenCommand, Mode=OneWay}"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="Open Current Session Telemetry">
                                <Button.Content>
                                    <wpf:ColorAbleIcon RebindOnVisibilityChange="True" HorizontalAlignment="Stretch"
                                                       VerticalAlignment="Stretch" Stretch="Uniform"
                                                       Margin="{Binding IconMargin, RelativeSource={RelativeSource AncestorType=statusIcon:StatusIconControl}}"
                                                       MaxWidth="{Binding IconMaxWidth, RelativeSource={RelativeSource AncestorType=statusIcon:StatusIconControl}}"
                                                       StrokeBrush="{StaticResource LightGrey01Brush}" Width="48">
                                        <ContentPresenter
                                            Content="{StaticResource ChampionshipIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                        </Grid>
                        <Grid Row="0">
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Style="{StaticResource StandardText}"
                                       FontWeight="Bold"
                                       FontSize="{StaticResource BigFontSize}"
                                       Text="Championship Event Completed" />
                                <TextBlock Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                           Style="{StaticResource StandardText}"
                                           FontWeight="Bold"
                                           FontSize="{StaticResource SmallFontSize}"
                                           Text="(Click to show results.)" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type events:DriversNewClassStandingsViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="20">
                        <ContentPresenter Content="{Binding EventTitleViewModel}"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel  Grid.IsSharedSizeScope="True">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DriversStandingName"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DriversStandingCarName"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DriversStandingPoints"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DriversStandingPoints"/>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="DriversStandingIcon"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Background="{StaticResource DarkGrey01Brush}">
                                <TextBlock  Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}" HorizontalAlignment="Center"  Text="#" Foreground="{StaticResource LightBlueBrush}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"   Text="# +/-" Margin="10,0,10,0" Foreground="{StaticResource LightBlueBrush}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}" Foreground="{StaticResource LightBlueBrush}"  Text="Driver Name" Margin="10,0,10,0"/>
                            <TextBlock Grid.Column="3" Visibility="{Binding IsCarNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}" Foreground="{StaticResource LightBlueBrush}"  Text="Driver Car" Margin="10,0,10,0"/>
                            <TextBlock Grid.Column="4" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="Total Points" Margin="10,0,10,0" Foreground="{StaticResource LightBlueBrush}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="Gap to Lead." Margin="10,0,10,0" Foreground="{StaticResource LightBlueBrush}" />
                        </Grid>
                            <ItemsControl ItemsSource="{Binding DriversNewStandings}" VerticalAlignment="Top" HorizontalAlignment="Center">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Margin="2">
                                        <Grid Margin="3" Background="{StaticResource Anthracite02Brush}">
                                            <ContentPresenter Content="{Binding }" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DataTemplate>

