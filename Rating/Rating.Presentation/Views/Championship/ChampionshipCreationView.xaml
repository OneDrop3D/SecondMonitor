<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
                    xmlns:creation="clr-namespace:SecondMonitor.Rating.Application.Championship.ViewModels.Creation;assembly=Rating.Application"
                    xmlns:helpButton="clr-namespace:SecondMonitor.WindowsControls.WPF.HelpButton;assembly=WindowsControls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../RatingPresentation.xaml" />
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type creation:ClassesSelectionViewModel}">
                <DockPanel Background="{StaticResource Anthracite01Brush}">
                    <TextBlock DockPanel.Dock="Top"  Style="{StaticResource StandardText}" VerticalAlignment="Center" FontSize="{StaticResource BigFontSize}" Margin="10" Text="Allowed Classes:"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
                        <Button Width="48" Command="{Binding SelectAllCommand}" DockPanel.Dock="Left"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Select All">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource AllIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="48" Command="{Binding UnselectAllCommand}" DockPanel.Dock="Left"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Unselect all">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource NoneIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <ListBox DockPanel.Dock="Bottom"  BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}"
                             Background="{StaticResource Anthracite01Brush}"
                             ItemsSource="{Binding Classes }">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border DockPanel.Dock="Bottom" BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Padding="5">
                                    <CheckBox IsChecked="{Binding IsChecked}" Foreground="{StaticResource LightGrey01Brush}" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource StandardText}" Text="{Binding Caption}" VerticalAlignment="Center"/>
                                    </CheckBox>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type creation:ChampionshipCreationViewModel}">
                <Grid Background="{StaticResource Anthracite01Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" >
                        <DockPanel LastChildFill="False">
                            <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center" FontSize="{StaticResource BigFontSize}" Margin="10" Text="Select Simulator:" DockPanel.Dock="Left"/>
                            <ComboBox Style="{StaticResource StandardComboBoxStyle}" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="10" Width="150" ItemsSource="{Binding AvailableSimulators}" IsEnabled="{Binding IsSimulatorSelectionEnabled}" SelectedItem="{Binding SelectedSimulator}" DockPanel.Dock="Left"/>
                            <Button Width="48" Command="{Binding ConfirmSimulatorCommand}" DockPanel.Dock="Left"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="Confirm Simulator." Visibility="{Binding IsSimulatorSelectionEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Button.Content>
                                    <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Content="{StaticResource OkIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center" FontSize="{StaticResource BigFontSize}" Margin="10,0,10,0" Text="Title: " DockPanel.Dock="Left"/>
                            <TextBox Style="{StaticResource StandardTextBox}" VerticalAlignment="Center" FontSize="{StaticResource BigFontSize}" Margin="10,0,10,0" MinWidth="300" Text="{Binding ChampionshipTitle}" DockPanel.Dock="Left"/>
                            <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center" FontSize="{StaticResource BigFontSize}" Margin="10,0,10,0" Text="Options: " DockPanel.Dock="Left"/>
                            <!--<CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding AiNamesCanChange}" VerticalAlignment="Center" VerticalContentAlignment="Center"  Content="AI names can change" DockPanel.Dock="Left" Margin="5,0,0,0"/>-->
                            
                            <StackPanel Orientation=" Vertical" VerticalAlignment="Center" Margin="0,0,0,0">
                                
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                                    <CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding IsTrackAllClassesEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center"  Content="Multiclass Championship - Track All Classes, not only players class." DockPanel.Dock="Left" Margin="10,0,0,0" ToolTip="Enables tracking of all participating classes."/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding IsManufacturerScoringEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center"  Content="Enable Manufacturers Championship" DockPanel.Dock="Left" Margin="10,0,0,0" ToolTip="Allows tracking of manufacturers points."/>
                                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" VerticalContentAlignment="Center" Margin="10,0,0,0" Width="150" ItemsSource="{Binding AllAvailableScoringKinds}" SelectedItem="{Binding SelectedManufacturerScoring}" DockPanel.Dock="Left"/>
                                </StackPanel>


                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Visibility="{Binding IsTeamScoringCheckBoxVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding IsTeamScoringEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center"  Content="Enable Teams Championship" DockPanel.Dock="Left" Margin="10,0,0,0" ToolTip="Allows tracking of team points."/>
                                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" VerticalContentAlignment="Center" Margin="10,0,0,0" Width="150" ItemsSource="{Binding AllAvailableScoringKinds}" SelectedItem="{Binding SelectedTeamsScoring}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation=" Vertical" VerticalAlignment="Center" Margin="30,0,0,0">
                                <CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding IsClassChangeEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center"  Content="Allow class changes" DockPanel.Dock="Left" Margin="10,0,0,0" ToolTip="Allows to change the class mid-championship"/>
                                <CheckBox Foreground="{StaticResource LightGrey01Brush}" IsChecked="{Binding IsMysteryClass}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Random class" DockPanel.Dock="Left" Margin="10,0,0,0"  ToolTip="Random changes of classes after each race." Visibility="{Binding IsClassChangeEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                            <helpButton:HelpButton HelpUrl="https://gitlab.com/winzarten/SecondMonitor/wikis/Championship-Creation" Width="48" DockPanel.Dock="Right" />
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Visibility="{Binding IsSimulatorSelectionEnabled, Converter={StaticResource InvertedBooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"  BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}">
                                <ContentPresenter Content="{Binding CalendarDefinitionViewModel}"/>
                            </Border>
                            <Border Grid.Column="1"  BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Visibility="{Binding IsMysteryClass, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ContentPresenter Content="{Binding ClassesSelectionViewModel}"/>
                            </Border>
                            <Border Grid.Column="2"  BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}">
                                <ContentPresenter Content="{Binding SessionsDefinitionViewModel}"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Grid.Row="2" Margin="0,0,30,30">
                        <Button Height="55" HorizontalAlignment="Right"
                                IsEnabled="{Binding IsOkButtonEnabled}"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding OkCommand}">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource OkIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Height="55" HorizontalAlignment="Right"
                                Style="{StaticResource StandardButton}"
                                Command="{Binding CancelCommand}">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="5,0,5,0" StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource CancelIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>