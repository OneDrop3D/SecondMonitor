<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:SecondMonitor.WindowsControls.WPF.Behaviors"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters"
                    xmlns:carStatus="clr-namespace:SecondMonitor.ViewModels.CarStatus;assembly=SecondMonitor.ViewModels"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
    <converters:DoubleToStringNoDecimalConverter x:Key="DoubleConverter" />
    <DataTemplate DataType="{x:Type carStatus:PedalsAndGearViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>
            <Grid Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="2"
                                        BorderBrush="{StaticResource DarkGrey05Brush}"
                                        BorderThickness="2" CornerRadius="4">
                        <Grid VerticalAlignment="Stretch">
                            <!--<Grid Height="2" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                  Background="{StaticResource LightGrey01Brush}" Grid.ZIndex="2" ToolTip="Filtered throttle (i.e. after TC application).">
                                <i:Interaction.Behaviors>
                                    <behaviors:TopMarginPercentageBehavior
                                        Percentage="{Binding ThrottleFilteredPercentage, Mode=OneWay}" />
                                </i:Interaction.Behaviors>
                            </Grid>-->
                            <Grid VerticalAlignment="Top" Background="Green">
                                <b:Interaction.Behaviors>
                                    <behaviors:PercentagesHeightBehavior
                                                    Percentage="{Binding ThrottlePercentage}" />
                                </b:Interaction.Behaviors>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold"
                                                   Style="{StaticResource StandardText}"
                                                   Text="{Binding ThrottlePercentage,Converter={StaticResource DoubleConverter}}" />
                            <ContentPresenter Panel.ZIndex="5" Content="{StaticResource ThrottleIcon}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          MaxWidth="30" Margin="5,0,5,0" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="1"
                                        BorderBrush="{StaticResource DarkGrey05Brush}"
                                        BorderThickness="2" CornerRadius="4">
                        <Grid VerticalAlignment="Stretch">
                            <!--<Grid Height="2" Margin="0,0,0,0" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                  Background="{StaticResource LightGrey01Brush}" Grid.ZIndex="2" ToolTip="Filtered brake (i.e. after Abs application).">
                                <i:Interaction.Behaviors>
                                    <behaviors:TopMarginPercentageBehavior
                                        Percentage="{Binding BrakeFilteredPercentage, Mode=OneWay}" />
                                </i:Interaction.Behaviors>
                            </Grid>-->
                            <Grid VerticalAlignment="Top" Background="{StaticResource DarkRed01Brush}">
                                <b:Interaction.Behaviors>
                                    <behaviors:PercentagesHeightBehavior
                                                    Percentage="{Binding BrakePercentage}" />
                                </b:Interaction.Behaviors>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold"
                                                   Style="{StaticResource StandardText}"
                                                   Text="{Binding BrakePercentage,Converter={StaticResource DoubleConverter}}" />
                            <ContentPresenter Panel.ZIndex="5" Content="{StaticResource BrakeIcon}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          MaxWidth="30" Margin="5,0,5,0" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="0"
                                        BorderBrush="{StaticResource DarkGrey05Brush}"
                                        BorderThickness="2" CornerRadius="4">
                        <Grid VerticalAlignment="Stretch">
                            <Grid VerticalAlignment="Top" Background="{StaticResource ClutchPedalColor}">
                                <b:Interaction.Behaviors>
                                    <behaviors:PercentagesHeightBehavior
                                                    Percentage="{Binding ClutchPercentage}" />
                                </b:Interaction.Behaviors>
                            </Grid>
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold"
                                                   Style="{StaticResource StandardText}"
                                                   Text="{Binding ClutchPercentage,Converter={StaticResource DoubleConverter}}" />
                            <ContentPresenter Panel.ZIndex="5" Content="{StaticResource ClutchIcon}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          MaxWidth="30" Margin="5,0,5,0" />
                        </Grid>
                    </Border>
                </Grid>
                <Grid Column="1">
                    <Border Grid.Column="0"
                                        BorderBrush="{StaticResource DarkGrey05Brush}"
                                        BorderThickness="2" CornerRadius="4">
                        <Grid>
                            <TextBlock HorizontalAlignment="Center" FontWeight="Bold"
                                                   Style="{StaticResource StandardText}"
                                                   Text="{Binding WheelRotation,Converter={StaticResource DoubleConverter}}" />
                            <ContentPresenter Panel.ZIndex="5" Content="{StaticResource SteeringWheel}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          MaxWidth="60" Margin="5,0,5,0"
                                                          RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <RotateTransform
                                                    Angle="{Binding WheelRotation}" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="1" BorderBrush="{StaticResource DarkGrey05Brush}"
                                BorderThickness="2" CornerRadius="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Grid Grid.Column="0" Margin="5,0,5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock HorizontalAlignment="Center" Grid.Column="0" VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   MinWidth="40"
                                   FontSize="{StaticResource NormalFontSize}"
                                   FontWeight="Bold"
                                   Style="{StaticResource StandardText}"
                                   Visibility="{Binding IsLowestSpeedEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding LowestSpeedFormatted}" ToolTip="Lowest Speed recently" />

                        <TextBlock HorizontalAlignment="Center" Grid.Column="1"
                                   TextAlignment="Center"
                                   MinWidth="40"
                                   FontWeight="Bold" Margin="10,0,10,0"
                                   FontSize="{StaticResource GearIndicationFontSize}"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource StandardText}"
                                   Text="{Binding Speed}" />
                        
                        <TextBlock HorizontalAlignment="Center" Grid.Column="2" VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   MinWidth="40"
                                   FontSize="{StaticResource NormalFontSize}"
                                   FontWeight="Bold"
                                   Style="{StaticResource StandardText}"
                                   Visibility="{Binding IsHighestSpeedEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   Text="{Binding HighestSpeedFormatted}" ToolTip="Highest Speed in recently" />
                    </Grid>
                    <TextBlock HorizontalAlignment="Center" Grid.Column="1"
                                       FontSize="{StaticResource GearIndicationFontSize}"
                                       FontWeight="Bold"
                                       Style="{StaticResource StandardText}"
                                       Text="{Binding Gear}" />
                    <TextBlock HorizontalAlignment="Center" Grid.Column="2" VerticalAlignment="Center"
                                           FontSize="{StaticResource NormalFontSize}"
                                           FontWeight="Bold"
                                           Style="{StaticResource StandardText}"
                                           Text="{Binding Rpm}" />
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>