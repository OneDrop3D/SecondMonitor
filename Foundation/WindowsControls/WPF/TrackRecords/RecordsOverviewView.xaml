<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:trackRecords="clr-namespace:SecondMonitor.ViewModels.TrackRecords;assembly=SecondMonitor.ViewModels"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type trackRecords:CarRecordSummaryViewModel}">
                <Border Grid.Column="0" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1" Padding="1,1,1,1">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}" Margin="0,0,20,0"
                              Text="{Binding CarName}" VerticalAlignment="Center" />
                    <Grid DockPanel.Dock="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="0">
                            <TextBlock Style="{StaticResource StandardText}" Text="P: "
                                       ToolTip="Best Time In Practice" VerticalAlignment="Center" />
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestPractice, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                                           ToolTip="Best Time In Practice" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestPracticeSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding BestPracticeSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="1">
                            <TextBlock Style="{StaticResource StandardText}" Text="Q: "
                                       ToolTip="Best Time In Qualification" VerticalAlignment="Center" />
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestQualification, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                                           ToolTip="Best Time In Qualification" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestQualificationSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding BestQualificationSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="2">
                            <TextBlock Style="{StaticResource StandardText}" Text="R: " ToolTip="Best Time In Race"  VerticalAlignment="Center"/>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestRace, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                                           ToolTip="Best Time In Race" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestRaceSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding BestRaceSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="10" Grid.Column="3">
                            <TextBlock Style="{StaticResource StandardText}" Text="Best: " ToolTip="Best Time Overall" VerticalAlignment="Center" />
                            <StackPanel Orientation="Vertical">
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestOverall, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                                           ToolTip="Best Time Overall" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestOverallSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding BestOverallSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DockPanel>
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type trackRecords:ClassRecordsViewModel}">
                <Border Grid.Column="0" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1" Padding="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}"
                                   FontSize="{StaticResource BigFontSize}" Text="{Binding ClassName}" VerticalAlignment="Center" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource BigFontSize}" Text="Class Best: " />
                            <StackPanel Orientation="Vertical">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}"
                                           FontSize="{StaticResource BigFontSize}"
                                           Text="{Binding OverallBest,  Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                                <TextBlock Style="{StaticResource StandardText}" HorizontalAlignment="Center"
                                           Text="{Binding OverallBestSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding OverallBestSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                                </StackPanel>
                                <Button Margin="5,0,0,0" Width="36"  VerticalAlignment="Bottom"
                                    Style="{StaticResource StandardButton}" Command="{Binding RemoveClassCommand}" CommandParameter="{Binding .}" ToolTip="Removes Records for this Class.">
                                <Button.Content>
                                    <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Content="{StaticResource TrashIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            </StackPanel>
                    </DockPanel>
                    <ItemsControl Grid.Row="1" BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}"
                                  Background="{StaticResource Anthracite01Brush}"
                                  ItemsSource="{Binding CarRecordViewModels }" />
                    <!--<ListBox Grid.Row="1" BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}" Background="{StaticResource Anthracite01Brush}" ItemsSource="{Binding CarRecordViewModels }">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">
                                    <Grid HorizontalAlignment="Stretch">
                                        <ContentPresenter Content="{Binding}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>-->
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type trackRecords:TracksAllRecordsViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="10" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}" Margin="0,0,30,0" VerticalAlignment="Center"
                                   FontSize="{StaticResource ExtraBigFontSize}" Text="{Binding TrackName}" />
                        <Button Margin="15,0,0,0" Width="36"  VerticalAlignment="Bottom" DockPanel.Dock="Right"
                                Style="{StaticResource StandardButton}" Command="{Binding DeleteAllRecordsForTrack}" CommandParameter="{Binding .}" ToolTip="Removes Records for this Track.">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource TrashIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                       FontSize="{StaticResource BigFontSize}" Text="Record: " />
                            <StackPanel Orientation="Vertical">
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource StandardText}"
                                           FontSize="{StaticResource BigFontSize}"
                                           Text="{Binding OverallBest,  Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                                <TextBlock Style="{StaticResource StandardText}" HorizontalAlignment="Center"
                                           Text="{Binding OverallBestSpeed}" FontSize="{StaticResource SmallFontSize}"
                                           Visibility="{Binding OverallBestSpeed, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                        <ItemsControl BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}" Background="{StaticResource Anthracite01Brush}" MinHeight="200"  ItemsSource="{Binding ClassRecords }">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="5">
                                        <Grid HorizontalAlignment="Stretch">
                                            <ScrollContentPresenter CanVerticallyScroll="False" CanHorizontallyScroll="False" Content="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DataTemplate>
            <DataTemplate DataType="{x:Type trackRecords:RecordsOverviewWindowViewModel}">
                <Grid Background="{StaticResource Anthracite01Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MaxHeight="800" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Simulator: "
                                           Margin="10,5,0,10" VerticalAlignment="Center"
                                           FontSize="{StaticResource BigFontSize}" />
                                <ComboBox Margin="5,5,5,10" VerticalAlignment="Center"
                                          ItemsSource="{Binding Simulators}"
                                          SelectedItem="{Binding SelectedSimulator}"
                                          Style="{StaticResource StandardComboBoxStyle}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource StandardText}" Text="{Binding }" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Grid  DockPanel.Dock="Right">
                            <Button Margin="5" Width="48" Height="48"
                                    Style="{StaticResource StandardButton}" Command="{Binding DeleteAllRecordsForSimulator}" ToolTip="Removes All Records for the Selected Simulator">
                                <Button.Content>
                                    <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Content="{StaticResource TrashIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            </Grid>
                            <!--<StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <CheckBox Content="- Practice"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,10,0,10"
                                          IsChecked="{Binding IsPracticeChecked}" />
                                <CheckBox Content="- Qualification"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="15,10,0,10"
                                          IsChecked="{Binding IsQualificationChecked}" />
                                <CheckBox Content="- Race"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="15,10,15,10"
                                          IsChecked="{Binding IsRaceChecked}" />
                            </StackPanel>-->
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1">
                            <ListBox BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}" Background="{StaticResource Anthracite01Brush}" MinHeight="200"  ItemsSource="{Binding AvailableTracks }"
                                     SelectedItem="{Binding SelectedTrack}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="5" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="330" SharedSizeGroup="TrackTemplateGroup" />
                                            </Grid.ColumnDefinitions>
                                            <Grid HorizontalAlignment="Stretch">
                                                <ScrollContentPresenter CanVerticallyScroll="False" CanHorizontallyScroll="False" Content="{Binding}" />
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                        <Border Grid.Column="1" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1">
                            <ContentPresenter Content="{Binding TracksAllRecordsViewModel}" />
                        </Border>
                    </Grid>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>