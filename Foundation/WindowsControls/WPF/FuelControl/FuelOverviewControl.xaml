<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:fuelControl="clr-namespace:SecondMonitor.WindowsControls.WPF.FuelControl" xmlns:quantityText="clr-namespace:SecondMonitor.WindowsControls.WPF.QuantityText"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF"
                    xmlns:fuelStatus="clr-namespace:SecondMonitor.ViewModels.CarStatus.FuelStatus;assembly=SecondMonitor.ViewModels"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fuelStrategy="clr-namespace:SecondMonitor.ViewModels.FuelConsumption.FuelStrategy;assembly=SecondMonitor.ViewModels"
                    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="FuelAndHybridOverviewControl.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    
    <DataTemplate DataType="{x:Type fuelStatus:FuelOverviewViewModel}" x:Key="NewFuelDataTemplate">
        <Border BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="2" CornerRadius="2" Padding="5">
            <fuelControl:FuelAndHybridOverviewControl 
                BlinkToColor="{StaticResource Anthracite01Color}"
                FuelPercentage="{Binding FuelPercentage}"
                FuelState="{Binding FuelState}"
                FuelStatusColor="{StaticResource LightGrey01Brush}"
                FuelStatusMightBeColor="{StaticResource Orange01Color}"
                FuelStatusNotEnoughColor="{StaticResource HighQuantityColor}"
                FuelStatusOkColor="{StaticResource Green01Color}"
                FuelStatusUnknownColor="{StaticResource LightGrey01Color}"
                MaximumFuel="{Binding MaximumFuel}"/>
        </Border>
    </DataTemplate>

    <fuelControl:FuelControlTemplateSelector ClassFuelDataTemplate="{StaticResource ClassFuelDataTemplate}" NewFuelDataTemplate="{StaticResource NewFuelDataTemplate}" x:Key="FuelControlTemplateSelector" />
    <converters:TimeSpanToMinutesSecondsConverter x:Key="MinutesSecondsConverter" />
    <converters:DoubleToScalableDecimalsConverter x:Key="DoubleToScalable" />
    <converters:RefuelingWindowStateToColorConverter WithContingencyFuelBrush="{StaticResource Green01Brush}" NoContingencyFuelBrush="{StaticResource Orange1Brush}" ClosedBrush="{StaticResource LightGrey01Brush}" x:Key="PitOpenToColorConverter" />
    
    <DataTemplate DataType="{x:Type fuelStatus:FuelOverviewViewModel}">
       <ContentPresenter Content="{Binding .}" ContentTemplate="{StaticResource NewFuelDataTemplate}" />
    </DataTemplate>
</ResourceDictionary>