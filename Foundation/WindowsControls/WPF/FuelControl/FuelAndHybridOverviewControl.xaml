<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fuelControl="clr-namespace:SecondMonitor.WindowsControls.WPF.FuelControl"
                    xmlns:quantityText="clr-namespace:SecondMonitor.WindowsControls.WPF.QuantityText"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:fuelStatus="clr-namespace:SecondMonitor.ViewModels.CarStatus.FuelStatus;assembly=SecondMonitor.ViewModels"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:behaviors="clr-namespace:SecondMonitor.WindowsControls.WPF.Behaviors"
                    xmlns:fuelStrategy="clr-namespace:SecondMonitor.ViewModels.FuelConsumption.FuelStrategy;assembly=SecondMonitor.ViewModels"
                    xmlns:virtualTankToTank="clr-namespace:SecondMonitor.ViewModels.FuelConsumption.FuelStrategy.VirtualTankToTank;assembly=SecondMonitor.ViewModels"
                    xmlns:stint="clr-namespace:SecondMonitor.ViewModels.FuelConsumption.FuelStrategy.Stint;assembly=SecondMonitor.ViewModels"
                    mc:Ignorable="d">
    
    <DataTemplate DataType="{x:Type fuelStatus:FuelDeltaViewModel}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource StandardText}"
                       FontWeight="Bold"
                       Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                       Text="{Binding Name}"
            />
            <TextBlock Style="{StaticResource StandardText}"
                       FontSize="{StaticResource SmallFontSize}"
                       FontWeight="Bold"
                       Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                       Text="{Binding FormattedValue}"
            />
        </StackPanel>
    </DataTemplate>

    <DrawingBrush x:Key="FuelToAddBrush" TileMode="Tile" Viewport="0,0,8,8" Viewbox="0,0,2,2" ViewportUnits="Absolute" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <GeometryDrawing>
                <GeometryDrawing.Pen>
                    <Pen Thickness="1" Brush="{StaticResource LightBlueBrush}" />
                </GeometryDrawing.Pen>
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <LineGeometry StartPoint="0,1" EndPoint="2,1" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingBrush.Drawing>
    </DrawingBrush>
    
    <converters:RefuelingWindowStateToColorConverter WithContingencyFuelBrush="{StaticResource Green01Brush}" NoContingencyFuelBrush="{StaticResource Orange1Brush}" ClosedBrush="{StaticResource LightRed02Brush}" 
                                                     x:Key="PitOpenStatusIconToColorConverter" />
    <converters:HybridSystemStatusToBrushConverter x:Key="HybridSystemStatusToBrushConverter"
                                                   UnAvailableBrush="{StaticResource LightGrey01Brush}"
                                                   OffBrush="{StaticResource LightGrey02Brush}"
                                                   BuildBrush="{StaticResource LightBlueBrush}"
                                                   BalancedBrush="{StaticResource Green05Brush}"
                                                   AttackBrush="{StaticResource Orange1Brush}"
                                                   QualificationBrush="{StaticResource LightRed02Brush}" />

    <converters:HybridChargeChangeToBrushConverter x:Key="HybridChargeChangeToBrushConverter"
                                                   NoneBrush="{StaticResource LightGrey01Brush}"
                                                   DischargeBrush="{StaticResource LightBlueBrush}"
                                                   RechargeBrush="{StaticResource Green05Brush}" />

    <converters:DoubleSignToBrushConverter x:Key="ChargeChangeConverter" ZeroBrush="{StaticResource LightGrey01Brush}"
                                           PositiveBrush="{StaticResource Green05Brush}"
                                           NegativeBrush="{StaticResource LightRed02Brush}" />

    <fuelControl:HybridEnduranceStateToBrushConverter x:Key="HybridEnduranceStateToBrushConverter" OkBrush="{StaticResource Green05Brush}" ErrorBrush="{StaticResource LightRed02Brush}" WarningBrush="{StaticResource Orange1Brush}"/>

    <converters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
    <converters:InverseDoubleToGridLengthConverter x:Key="InverseDoubleToGridLengthConverter" />
    
    <DataTemplate DataType="{x:Type fuelStatus:FuelAtRaceEndMarkerViewModel}">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}"  ToolTip="Predicted fuel at race end">
            <Grid Background="{StaticResource BlackBrush}" VerticalAlignment="Bottom" Height="3" HorizontalAlignment="Stretch" ToolTip="Predicted fuel at race end">
                <b:Interaction.Behaviors>
                    <converters:BottomMarginPercentageBehavior Percentage="{Binding FuelAtRaceEndPercentage}" SubtractAssociatedObjectHeight="True" />
                </b:Interaction.Behaviors>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fuelStatus:FuelToAddMarkerViewModel}">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" >
            <Grid VerticalAlignment="Bottom" HorizontalAlignment="Stretch" >
                <quantityText:VolumeQuantityText VerticalAlignment="Top" Grid.ZIndex="1"
                                                 HorizontalAlignment="Right"
                                                 FontSize="10"
                                                 FontWeight="Bold"
                                                 Foreground="{StaticResource LightGrey01Brush}"
                                                 Quantity="{Binding AfterRefuelFuel}"
                                                 ShowUnitSymbol="True"
                                                 VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Opacity="0.75" Background="{StaticResource FuelToAddBrush}" />
                <b:Interaction.Behaviors>
                    <behaviors:PercentagesHeightBehavior Percentage="{Binding HeightPercentage}" />
                    <converters:BottomMarginPercentageBehavior Percentage="{Binding BottomMarginPercentage}" />
                </b:Interaction.Behaviors>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fuelStatus:HybridOverviewViewModel}">
        <Grid Margin="10,0,0,0" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"  MinHeight="120" />
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Row="0" MinHeight="75" HorizontalAlignment="Stretch" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <wpf:ColorAbleIcon Grid.Column="0" HorizontalAlignment="Right" StrokeBrush="{Binding Path=HybridSystemMode, Converter={StaticResource HybridSystemStatusToBrushConverter}}" VerticalAlignment="Center" Margin="0,0,5,0">
                            <ContentPresenter Content="{StaticResource Battery2Icon}" Height="25"/>
                        </wpf:ColorAbleIcon>
                        <Border Margin="0,15,0,0" Grid.Column="1"
                                BorderBrush="{Binding Path=HybridSystemMode, Converter={StaticResource HybridSystemStatusToBrushConverter}}"
                                BorderThickness="4" CornerRadius="5" VerticalAlignment="Stretch" Width="25"
                                HorizontalAlignment="Center">
                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="-1"
                                  Background="{StaticResource Anthracite02Brush}">
                                <ContentPresenter Content="{Binding FuelAtRaceEndMarkerViewModel}" Grid.ZIndex="2"/>
                                <wpf:ColorAbleIcon RebindOnVisibilityChange="True" Grid.ZIndex="2"  HorizontalAlignment="Center" StrokeBrush="{StaticResource Green01Brush}" Visibility="{Binding IsRecharging, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center">
                                    <ContentPresenter Content="{StaticResource UpArrows}"/>
                                </wpf:ColorAbleIcon>
                                <wpf:ColorAbleIcon RebindOnVisibilityChange="True" Grid.ZIndex="2"  HorizontalAlignment="Center" StrokeBrush="{StaticResource Blue03Brush}" Visibility="{Binding IsDischarging, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch">
                                    <ContentPresenter Content="{StaticResource DownArrows}"/>
                                </wpf:ColorAbleIcon>
                                <Grid Grid.ZIndex="1"
                                      Background="{Binding Path=HybridChargeChange, Converter={StaticResource HybridChargeChangeToBrushConverter}}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                    <b:Interaction.Behaviors>
                                        <behaviors:PercentagesHeightBehavior Percentage="{Binding CurrentHybridCharge}" />
                                    </b:Interaction.Behaviors>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid Row="1">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource StandardText}" Foreground="{Binding HybridEnduranceState, Converter={StaticResource HybridEnduranceStateToBrushConverter}}"
                                   Text="{Binding CurrentHybridCharge, Converter={StaticResource DoubleToStringNoDecimalConverter}, StringFormat={}{0}%}"/>
                    </Grid>
                </Grid>
            </Grid>
            <Grid Row="1">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource SmallFontSize}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="Current Lap: "/>
                        <TextBlock FontSize="{StaticResource SmallFontSize}" Foreground="{Binding CurrentLapHybridUsage, Converter={StaticResource ChargeChangeConverter}}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="{Binding CurrentLapHybridUsage, Converter={StaticResource DoubleToStringNoDecimalConverter}, ConverterParameter='+#;-#;0', StringFormat={}{0}%}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="{StaticResource SmallFontSize}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="Last Lap: "/>
                        <TextBlock FontSize="{StaticResource SmallFontSize}" Foreground="{Binding PreviousLapHybridUsage, Converter={StaticResource ChargeChangeConverter}}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="{Binding PreviousLapHybridUsage, Converter={StaticResource DoubleToStringNoDecimalConverter}, ConverterParameter='+#;-#;0', StringFormat={}{0}%}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding FuelAtRaceEndMarkerViewModel.IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock FontSize="{StaticResource SmallFontSize}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="Race End: "/>
                        <TextBlock Foreground="{Binding HybridEnduranceState, Converter={StaticResource HybridEnduranceStateToBrushConverter}}" FontSize="{StaticResource SmallFontSize}" HorizontalAlignment="Center" Style="{StaticResource StandardText}" Text="{Binding HybridAtRaceEnd, Converter={StaticResource DoubleToStringNoDecimalConverter}, StringFormat={}{0}%}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource SmallFontSize}" Text="{Binding LapToFullEmptyLabel}" Style="{StaticResource StandardText}"/>
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource StandardText}" 
                                   Foreground="{Binding HybridEnduranceState, Converter={StaticResource HybridEnduranceStateToBrushConverter}}"
                                   Text="{Binding LapsUntilEmptyFormatted, StringFormat={}{0} Laps}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DataTemplate>
    
     <DataTemplate DataType="{x:Type virtualTankToTank:VirtualTankToTankPitStopViewModel}">
        <StackPanel>
            <TextBlock Margin="0,0,0,0"
                       Text="{Binding NextPitStopInfo}"
                       Style="{StaticResource StandardText}" VerticalAlignment="Center"
                       FontSize="{StaticResource BigFontSize}"
                       FontWeight="{Binding NextPitStopFontStyle, Converter={StaticResource FontStyleToWeightConverter}}"
                       Foreground="{Binding NextPitStopState, Converter={StaticResource PitOpenToColorConverter}}"
                       Visibility="{Binding IsNextPitStopInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsPitStopCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Pit Stops: " FontSize="{StaticResource SmallFontSize}"
                           VerticalAlignment="Center" Style="{StaticResource StandardText}"
                           Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}" />
                <TextBlock FontWeight="Bold" FontSize="{StaticResource SmallFontSize}"
                           VerticalAlignment="Center" Style="{StaticResource StandardText}"
                           Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}"
                           Text="{Binding PitStopCount}" />
            </StackPanel>
            <Border Padding="10" BorderThickness="2" BorderBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}" Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:ColorAbleIcon Margin="0,0,0,0"
                                       StrokeBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}"
                                       Width="24"
                                       RebindOnVisibilityChange="True">
                        <ContentPresenter Content="{StaticResource CircleLight2}" />
                    </wpf:ColorAbleIcon>
                    <TextBlock Margin="10,0,0,0" Text="{Binding FuelForNextPitStopLabel}"
                               Style="{StaticResource StandardText}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding VirtualEnergyNextPitStop}" VerticalAlignment="Center" Margin="5,0,0,0"
                               FontSize="{StaticResource BigFontSize}" FontWeight="Bold"
                               Style="{StaticResource StandardText}" />
                    <TextBlock Text="{Binding FuelCoefNextPitStop, StringFormat={}{0}/}" Margin="10,0,3,0" Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                    <quantityText:VolumeQuantityText VerticalAlignment="Center"
                                                     Margin="0,0,0,0"
                                                     FontSize="{StaticResource NormalFontSize}"
                                                     Foreground="{StaticResource LightGrey01Brush}"
                                                     ShowUnitSymbol="True"
                                                     Quantity="{Binding FuelForNextPitStop}"
                                                     DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                     Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                     VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsLastStopFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding FuelToAddLastStopLabel}" Style="{StaticResource StandardText}" />
                <TextBlock Text="{Binding VirtualEnergyLastPitStop}" FontWeight="Bold" Style="{StaticResource StandardText}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type fuelStrategy:StandardPitStopViewModel}">
        <StackPanel>
            <TextBlock Margin="0,0,0,0"
                       Text="{Binding NextPitStopInfo}"
                       Style="{StaticResource StandardText}" VerticalAlignment="Center"
                       FontSize="{StaticResource BigFontSize}"
                       FontWeight="{Binding NextPitStopFontStyle, Converter={StaticResource FontStyleToWeightConverter}}"
                       Foreground="{Binding NextPitStopState, Converter={StaticResource PitOpenToColorConverter}}"
                       Visibility="{Binding IsNextPitStopInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsPitStopCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Pit Stops: " FontSize="{StaticResource SmallFontSize}"
                           VerticalAlignment="Center" Style="{StaticResource StandardText}"
                           Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}" />
                <TextBlock FontWeight="Bold" FontSize="{StaticResource SmallFontSize}"
                           VerticalAlignment="Center" Style="{StaticResource StandardText}"
                           Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}"
                           Text="{Binding PitStopCount}" />
            </StackPanel>
            <Border Padding="10" BorderThickness="2" BorderBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}" Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:ColorAbleIcon Margin="0,0,0,0"
                                       StrokeBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}"
                                       Width="24"
                                       RebindOnVisibilityChange="True">
                        <ContentPresenter Content="{StaticResource CircleLight2}" />
                    </wpf:ColorAbleIcon>
                    <TextBlock Margin="10,0,0,0" Text="{Binding FuelForNextPitStopLabel}"
                               Style="{StaticResource StandardText}"
                               VerticalAlignment="Center" />
                    <quantityText:VolumeQuantityText VerticalAlignment="Center"
                                                     Margin="0,0,0,0"
                                                     Foreground="{StaticResource LightGrey01Brush}"
                                                     FontSize="{StaticResource BigFontSize}"
                                                     FontWeight="Bold"
                                                     ShowUnitSymbol="True"
                                                     Quantity="{Binding FuelForNextPitStop}"
                                                     DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                     Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                     VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsLastStopFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding FuelToAddLastStopLabel}" Style="{StaticResource StandardText}" />
                <quantityText:VolumeQuantityText VerticalAlignment="Bottom"
                                                 Margin="0,0,0,0"
                                                 Foreground="{StaticResource LightGrey01Brush}"
                                                 FontWeight="Bold"
                                                 ShowUnitSymbol="True"
                                                 Quantity="{Binding FuelToAddLastStop}"
                                                 DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                 Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                 VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>


    <DataTemplate DataType="{x:Type stint:StintPitStopViewModel}">
        <StackPanel>
            <TextBlock Margin="0,0,0,0"
                       Text="{Binding NextPitStopInfo}"
                       Style="{StaticResource StandardText}" VerticalAlignment="Center"
                       FontSize="{StaticResource BigFontSize}"
                       FontWeight="{Binding NextPitStopFontStyle, Converter={StaticResource FontStyleToWeightConverter}}"
                       Foreground="{Binding NextPitStopState, Converter={StaticResource PitOpenToColorConverter}}"
                       Visibility="{Binding IsNextPitStopInfoVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsPitStopCountVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="Pit Stops: " FontSize="{StaticResource SmallFontSize}"
                               VerticalAlignment="Center" Style="{StaticResource StandardText}"
                               Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}" />
                    <TextBlock FontWeight="Bold" FontSize="{StaticResource SmallFontSize}"
                               VerticalAlignment="Center" Style="{StaticResource StandardText}"
                               Foreground="{Binding RefuelingWindowState, Converter={StaticResource PitOpenToColorConverter}}"
                               Text="{Binding PitStopCount}" />
                </StackPanel>
                <TextBlock Text="{Binding CurrentStintTime, StringFormat={}Stint Left: {0}}"
                           Visibility="{Binding IsStintTimeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           FontSize="{StaticResource SmallFontSize}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource StandardText}" />

            </StackPanel>
            <Border Padding="10" BorderThickness="2" BorderBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}" Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding IsFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:ColorAbleIcon Margin="0,0,0,0"
                                       StrokeBrush="{Binding RefuelingWindowState, Converter={StaticResource PitOpenStatusIconToColorConverter}}"
                                       Width="24"
                                       RebindOnVisibilityChange="True">
                        <ContentPresenter Content="{StaticResource CircleLight2}" />
                    </wpf:ColorAbleIcon>
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextStintTime, StringFormat={}Next Stint: {0}}" 
                                       VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource StandardText}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsFuelToAddThisLapVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="10,0,0,0" Text="Add (This Lap):"
                                       Style="{StaticResource StandardText}"
                                       VerticalAlignment="Bottom" />
                            <quantityText:VolumeQuantityText VerticalAlignment="Center"
                                                             VerticalContentAlignment="Bottom"
                                                             Margin="8,0,0,-2"
                                                             Foreground="{StaticResource LightGrey01Brush}"
                                                             FontSize="{StaticResource BigFontSize}"
                                                             FontWeight="Bold"
                                                             ShowUnitSymbol="True"
                                                             Quantity="{Binding FuelToAddThisLap}"
                                                             DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                             Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                             VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsFuelToAddPitLapVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Margin="10,0,0,0" Text="{Binding FuelForNextPitStopLabel}"
                                       Style="{StaticResource StandardText}"
                                       VerticalAlignment="Bottom" />
                            <quantityText:VolumeQuantityText VerticalAlignment="Center"
                                                             VerticalContentAlignment="Bottom"
                                                             Margin="8,0,0,-2"
                                                             Foreground="{StaticResource LightGrey01Brush}"
                                                             FontSize="{StaticResource BigFontSize}"
                                                             FontWeight="Bold"
                                                             ShowUnitSymbol="True"
                                                             Quantity="{Binding FuelForNextPitStop}"
                                                             DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                             Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                             VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding IsLastStopFuelToAddVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding FuelToAddLastStopLabel}" Style="{StaticResource StandardText}" />
                <TextBlock Text="{Binding LastStintTime}" Style="{StaticResource StandardText}" />
                <quantityText:VolumeQuantityText VerticalAlignment="Bottom"
                                                 Margin="10,0,0,0"
                                                 Foreground="{StaticResource LightGrey01Brush}"
                                                 FontWeight="Bold"
                                                 ShowUnitSymbol="True"
                                                 Quantity="{Binding FuelToAddLastStop}"
                                                 DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                 Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                 VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <Style TargetType="fuelControl:FuelAndHybridOverviewControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="fuelControl:FuelAndHybridOverviewControl">
                    <Grid d:DataContext="{d:DesignInstance Type=fuelStatus:FuelOverviewViewModel, IsDesignTimeCreatable=True}" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Row="0" MinWidth="50">
                                        <quantityText:VolumeQuantityText VerticalAlignment="Bottom"
                                                                         HorizontalAlignment="Center"
                                                                         FontSize="{StaticResource SmallFontSize}"
                                                                         FontWeight="Bold"
                                                                         Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                                         Quantity="{Binding MaximumFuel}"
                                                                         ShowUnitSymbol="True"
                                                                         VolumeUnits="{Binding  DisplaySettingsViewModel.VolumeUnits, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Row="1" MinHeight="75">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Background="Transparent">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <Button Width="22" HorizontalAlignment="Left" Grid.Row="1" Opacity="0"
                                                    Command="{Binding IncreaseFuelMultiplierCommand}"
                                                    Style="{StaticResource StandardButton}"
                                                    ToolTip="Increase Multiplier by 1" DockPanel.Dock="Right" HorizontalContentAlignment="Left">
                                                <Button.Content>
                                                    <wpf:ColorAbleIcon Margin="-7" HorizontalAlignment="Left"
                                                                       StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                                        <ContentPresenter Content="{StaticResource PlusIcon}" />
                                                    </wpf:ColorAbleIcon>
                                                </Button.Content>
                                                <b:Interaction.Behaviors>
                                                    <behaviors:OpacityByParentMouseOverBehavior />
                                                </b:Interaction.Behaviors>
                                            </Button>
                                            <wpf:ColorAbleIcon Grid.Row="2" StrokeBrush="{Binding Path=FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ContentPresenter Content="{StaticResource FuelIcon}" Height="20" Width="20" />
                                            </wpf:ColorAbleIcon>
                                            <StackPanel Orientation="Horizontal" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Fuel Multiplier">
                                                <TextBlock Style="{StaticResource StandardText}" Text="x" VerticalAlignment="Center" FontSize="{StaticResource SmallFontSize}" ToolTip="Fuel Multiplier" Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"/>
                                                <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding FuelMultiplier, Converter={StaticResource PositiveIntToStringConverter}}" VerticalAlignment="Center" ToolTip="Fuel Multiplier" Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"/>
                                            </StackPanel>

                                            <Button Width="22" HorizontalAlignment="Left" Grid.Row="4" Opacity="0"
                                                    Command="{Binding DecreaseFuelMultiplierCommand}"
                                                    Style="{StaticResource StandardButton}"
                                                    ToolTip="Decreases Multiplier by 1" DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalContentAlignment="Left">
                                                <Button.Content> 
                                                    <wpf:ColorAbleIcon Margin="-7" HorizontalAlignment="Left"
                                                                       StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                                        <ContentPresenter Content="{StaticResource MinusIcon}" />
                                                    </wpf:ColorAbleIcon>
                                                </Button.Content>
                                                <b:Interaction.Behaviors>
                                                    <behaviors:OpacityByParentMouseOverBehavior />
                                                </b:Interaction.Behaviors>
                                            </Button>

                                        </Grid>
                                        <Border Grid.Column="1"
                                            BorderBrush="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                            BorderThickness="2" CornerRadius="5" VerticalAlignment="Stretch" Width="25"
                                            HorizontalAlignment="Right">
                                            <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                                  Background="{StaticResource Anthracite02Brush}">
                                                <ItemsControl ItemsSource="{Binding FuelMarkerViewModels}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Grid.ZIndex="2">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <Grid/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                </ItemsControl>
                                                <Grid Grid.ZIndex="1"
                                                      Background="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                      HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                                                    <b:Interaction.Behaviors>
                                                        <behaviors:PercentagesHeightBehavior
                                                            Percentage="{Binding FuelPercentage, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}" />
                                                    </b:Interaction.Behaviors>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid Row="2">
                                        <TextBlock VerticalAlignment="Bottom" FontSize="{StaticResource NormalFontSize}"
                                                                         FontWeight="Bold"
                                                                         HorizontalAlignment="Right"
                                                                         Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                                         Text="{Binding FuelRemainingLabel}"/>
                                    </Grid>
                                </Grid>
                            </Grid>
                            <Grid Row="1">
                                <StackPanel Orientation="Vertical">
                                <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource StandardButton}"
                                                Command="{Binding ShowFuelCalculatorCommand, Mode=OneWay}"
                                                HorizontalAlignment="Right" Height="36" Width="36"
                                                IsEnabled="{Binding IsFuelCalculatorButtonEnabled}"
                                                ToolTipService.ShowOnDisabled="True">
                                            <Button.ToolTip>
                                                <TextBlock>
                                                    Open the Fuel Calculator.
                                                    <LineBreak />
                                                    Requires previous session records, or 2 minutes of run time to be enabled.
                                                </TextBlock>
                                            </Button.ToolTip>
                                            <Button.Content>
                                                <wpf:ColorAbleIcon
                                                    StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button},Mode=OneWay}"
                                                    Margin="-4">
                                                    <ContentPresenter Content="{StaticResource CalculatorIcon}" />
                                                </wpf:ColorAbleIcon>
                                            </Button.Content>
                                        </Button>
                                        <Button Style="{StaticResource StandardButton}"
                                                Command="{Binding ResetCommand, Mode=OneWay}"
                                                HorizontalAlignment="Right" Height="36" Width="36">
                                            <Button.Content>
                                                <wpf:ColorAbleIcon Margin="-2"
                                                                   StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button},Mode=OneWay}">
                                                    <ContentPresenter Content="{StaticResource ResetIcon}" />
                                                </wpf:ColorAbleIcon>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*" MinWidth="20"/>
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Column="0" Row="0" ColumnSpan="3">
                                <ContentPresenter Content="{Binding PitStopsViewModel}"/>
                            </Grid>
                            <Grid Column="0" Row="1">
                                <StackPanel Orientation="Vertical" Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Time: " Style="{StaticResource StandardText}" />
                                        <TextBlock FontWeight="Bold" Style="{StaticResource StandardText}"
                                                   Text="{Binding TimeLeft, Mode=OneWay, Converter={StaticResource MinutesSecondsConverter}}"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}" />
                                        <TextBlock FontWeight="Bold" Margin="5,0,0,0"
                                                   Style="{StaticResource SmallText}"
                                                   Text="Δ"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                   Visibility="{Binding IsDeltaInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Margin="5,0,0,0" FontWeight="Bold"
                                                   Style="{StaticResource SmallText}"
                                                   Text="{Binding TimeDelta, Mode=OneWay, Converter={StaticResource MinutesSecondsConverter}}"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                   Visibility="{Binding   IsDeltaInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Laps: " Style="{StaticResource StandardText}" />
                                        <TextBlock FontWeight="Bold" Style="{StaticResource StandardText}"
                                                   Text="{Binding LapsLeft, Mode=OneWay, Converter={StaticResource DoubleToScalable}}"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}" />
                                        <TextBlock FontWeight="Bold" Margin="5,0,0,0"
                                                   Style="{StaticResource SmallText}"
                                                   Text="Δ"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                   Visibility="{Binding IsDeltaInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock FontWeight="Bold" Margin="5,0,0,0"
                                                   Style="{StaticResource SmallText}"
                                                   Text="{Binding LapsDelta, Mode=OneWay, Converter={StaticResource DoubleToScalable}}"
                                                   Foreground="{Binding FuelStatusColor, RelativeSource={RelativeSource AncestorType=fuelControl:FuelOverviewControl}, Mode=OneWay}"
                                                   Visibility="{Binding IsDeltaInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding FuelDeltaLabels}"
                                                  Visibility="{Binding IsDeltaInformationVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Grid>
                            <Grid Column="2" Row="1">
                                <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last Lap: " Style="{StaticResource SmallText}" />
                                        <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" Text="{Binding CurrentPerLap}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Last Min: " Style="{StaticResource SmallText}" />
                                        <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" Text="{Binding CurrentPerMinute}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Avg per Lap: " Style="{StaticResource SmallText}" />
                                        <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" Text="{Binding AvgPerLap}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Avg per Min: " Style="{StaticResource SmallText}" />
                                        <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" Text="{Binding AvgPerMinute}"/>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource StandardText}" Visibility="{Binding ConsumptionRemark, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"  FontSize="{StaticResource SmallFontSize}" FontWeight="Bold" Text="{Binding ConsumptionRemark}"/>

                                    
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Column="3">
                            <ContentPresenter Content="{Binding HybridOverviewViewModel}"/>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>