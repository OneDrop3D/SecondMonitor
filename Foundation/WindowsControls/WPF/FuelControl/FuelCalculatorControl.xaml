<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SecondMonitor.WindowsControls.WPF.FuelControl"
                    xmlns:quantityText="clr-namespace:SecondMonitor.WindowsControls.WPF.QuantityText"
                    xmlns:fuelStatus="clr-namespace:SecondMonitor.ViewModels.CarStatus.FuelStatus;assembly=SecondMonitor.ViewModels"
                    mc:Ignorable="d">

   <Style TargetType="local:FuelCalculatorControl">
       <Setter Property="Template">
           <Setter.Value>
               <ControlTemplate TargetType="local:FuelCalculatorControl">
                    <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}" CornerRadius="2" Padding="5"
                            d:DataContext="{d:DesignInstance fuelStatus:FuelCalculatorViewModel}"
                            >
                        <StackPanel Margin="0,5,0,5">
                            <TextBlock Margin="0,0,0,10" Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}" Text="Session Length:" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource StandardTextBox}" Margin="5,0,5,0" Text="{Binding  RequiredMinutes, Mode=TwoWay, Converter={StaticResource IntegerToStringConverter}, UpdateSourceTrigger=PropertyChanged}" MinWidth="30" />
                                <TextBlock Style="{StaticResource StandardText}" Text="Minutes"  Margin="5,0,5,0" />
                            </StackPanel>
                                <!--<TextBlock Style="{StaticResource StandardText}" Text="+" Margin="5,5,5,5" HorizontalAlignment="Center" VerticalAlignment="Center"/>-->
                            <StackPanel Orientation="Horizontal" >
                                <TextBox Style="{StaticResource StandardTextBox}" Margin="5,0,5,0" Text="{Binding RequiredLaps, Mode=TwoWay, Converter={StaticResource IntegerToStringConverter}, UpdateSourceTrigger=PropertyChanged}" MinWidth="30" />
                                <TextBlock Style="{StaticResource StandardText}" Text="Laps"  Margin="5,0,5,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" >
                                <TextBox Style="{StaticResource StandardTextBox}" Margin="5,0,5,0" Text="{Binding ExtraFuel, Mode=TwoWay, Converter={StaticResource IntegerToStringConverter}, UpdateSourceTrigger=PropertyChanged}" MinWidth="30" />
                                <TextBlock Style="{StaticResource StandardText}" Text="Extra Fuel (%)"  Margin="5,0,5,0" />
                            </StackPanel>
                            <Border BorderThickness="4" BorderBrush="{StaticResource DarkRed01Brush}" Margin="0,15,0,0">
                            <StackPanel Orientation="Horizontal" >
                                <TextBlock Style="{StaticResource StandardText}" Text="Requires:" Margin="5,0,5,0"/>
                                <quantityText:VolumeQuantityText FontSize="{StaticResource NormalFontSize}" Foreground="{StaticResource LightGrey01Brush}"  
                                                                  VolumeUnits="{Binding DisplaySettingsViewModel.VolumeUnits}"
                                                                  DecimalPlaces="{Binding DisplaySettingsViewModel.VolumeUnits, Converter={StaticResource VolumeUnitToDecimalPlacesConverterDefault}}"
                                                                  Quantity="{Binding RequiredFuel, Mode=OneWay}"
                                                                  Style="{StaticResource VolumeQuantityNoDecimalScaling}"
                                                                  ShowUnitSymbol="True"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
               </ControlTemplate>
           </Setter.Value>
       </Setter>

   </Style>
</ResourceDictionary>