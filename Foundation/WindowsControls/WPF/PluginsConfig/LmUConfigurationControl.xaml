<UserControl x:Class="SecondMonitor.WindowsControls.WPF.PluginsConfig.LmUConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:pluginsSettings="clr-namespace:SecondMonitor.ViewModels.PluginsSettings;assembly=SecondMonitor.ViewModels"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance pluginsSettings:LmUConfigurationViewModel}" >
    <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}" Padding="5" Background="{StaticResource Anthracite01Brush}">
        <StackPanel Background="{StaticResource Anthracite01Brush}">
            <CheckBox Foreground="{StaticResource LightGrey01Brush}" VerticalContentAlignment="Center" FontSize="{StaticResource NormalFontSize}" IsChecked="{Binding IsRestApiEnabled}" Content="Enable REST API" />
            <TextBlock Style="{StaticResource StandardText}" Margin="0,5,0,0">
                REST API is used for retrieval of additional data, which are not provided by the RF2 Shared Memory plugin.
                <LineBreak/>
                This includes virtual energy, or per-wheel tyre compound data.
                <LineBreak/>
                But this API is currently unstable and may cause performance issue or LmU Crashes.
            </TextBlock>
        </StackPanel>
    </Border>
</UserControl>
