<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pluginsSettings="clr-namespace:SecondMonitor.ViewModels.PluginsSettings;assembly=SecondMonitor.ViewModels"
                    xmlns:pluginsConfig="clr-namespace:SecondMonitor.WindowsControls.WPF.PluginsConfig">
    <DataTemplate DataType="{x:Type pluginsSettings:PluginsConfigurationViewModel}">
    <Grid Background="{StaticResource Anthracite01Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Column="0" Margin="5">
            <StackPanel Grid.Row="0" >
                <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}" Text="F1 Series Settings:" VerticalAlignment="Center" />
                <pluginsConfig:F12019ConfigurationControl  DataContext="{Binding F12019ConfigurationViewModel}"/>
                <TextBlock Margin="0,10,0,0" FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" Text="Forza Motorsport Settings" VerticalAlignment="Center" />
                <pluginsConfig:ForzaMotorsportConfigurationControl  DataContext="{Binding ForzaMotorsportConfigurationViewModel}"/>
                <TextBlock Margin="0,10,0,0" FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" Text="PCars 2 Settings" VerticalAlignment="Center" />
                <pluginsConfig:PCars2ConfigurationControl  DataContext="{Binding PCars2ConfigurationViewModel}"/>
                <TextBlock Margin="0,10,0,0" FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" Text="ACC Settings" VerticalAlignment="Center" />
                <pluginsConfig:AccConfigurationControl  DataContext="{Binding AccConfigurationViewModel}"/>
                <TextBlock Margin="0,10,0,0" FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" Text="AMS2 Settings" VerticalAlignment="Center" />
                <pluginsConfig:Ams2ConfigurationControl  DataContext="{Binding Ams2ConfigurationViewModel}"/>
                <TextBlock Margin="0,10,0,0" FontSize="{StaticResource BigFontSize}" Style="{StaticResource StandardText}" Text="LmU Settings" VerticalAlignment="Center" />
                <pluginsConfig:LmUConfigurationControl  DataContext="{Binding LmUConfigurationViewModel}"/>
                <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="These settings might require application restart to take effect." VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
