<UserControl x:Class="SecondMonitor.WindowsControls.WPF.CarSystems.VirtualEnergyControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SecondMonitor.WindowsControls.WPF.CarSystems"
             xmlns:behaviors="clr-namespace:SecondMonitor.WindowsControls.WPF.Behaviors"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:PercentageToBrushConverter x:Key="VirtualEnergyToBrushConverted"
                                               OkBrush="{StaticResource TimingGridOkVirtualEnergyBrush}"
                                               Below30Brush="{StaticResource TimingGridWarningVirtualEnergyBrush}"
                                               Below10Brush="{StaticResource TimingGridRedVirtualEnergyBrush}"/>
    </UserControl.Resources>
    <Grid Visibility="{Binding VirtualEnergyPercentage, RelativeSource={RelativeSource AncestorType=local:VirtualEnergyControl}, Converter={StaticResource NonNegativeNumberToVisibilityConverter}}">
        <Grid>
            <TextBlock Grid.ZIndex="2" Margin="0,2,0,0" Style="{StaticResource StandardText}" VerticalAlignment="Top" HorizontalAlignment="Center" 
                       Visibility="{Binding VirtualEnergyPercentage, RelativeSource={RelativeSource AncestorType=local:VirtualEnergyControl}, Converter={StaticResource NonNegativeNumberToVisibilityConverter}}"
                       Text="{Binding VirtualEnergyPercentage, RelativeSource={RelativeSource AncestorType=local:VirtualEnergyControl}, Converter={StaticResource DoubleToStringNoDecimalConverter}}"
            />
            <Grid Grid.ZIndex="1"
                  Background="{Binding VirtualEnergyPercentage, RelativeSource={RelativeSource AncestorType=local:VirtualEnergyControl}, Converter={StaticResource VirtualEnergyToBrushConverted}}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <b:Interaction.Behaviors>
                    <behaviors:PercentagesHeightBehavior Percentage="{Binding VirtualEnergyPercentage, RelativeSource={RelativeSource AncestorType=local:VirtualEnergyControl}}"></behaviors:PercentagesHeightBehavior>
                </b:Interaction.Behaviors>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
