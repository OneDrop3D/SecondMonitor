            <converters:FontStyleToWeightConverter x:Key="FontStyleToWeightConverter"/>
            <converters:VolumeUnitToDecimalPlacesConverter x:Key="VolumeUnitToDecimalPlacesConverterDefault"/>
            

            <Style x:Key="StandardText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource LightGrey01Brush}" />
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>
            
            <Style x:Key="StandardOutlinedText" TargetType="text:OutlinedTextBlock">
                <Setter Property="Fill" Value="{StaticResource LightGrey01Brush}" />
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
            </Style>

            <Style x:Key="StandardTextBox" TargetType="TextBox">
                <Setter Property="Foreground" Value="{StaticResource LightGrey01Brush}" />
                <Setter Property="FontSize" Value="{StaticResource NormalFontSize}" />
                <Setter Property="VerticalAlignment" Value="Bottom" />
                <Setter Property="MaxLength" Value="2048" />
                <Setter Property="Background" Value="{StaticResource Anthracite01Brush}" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
