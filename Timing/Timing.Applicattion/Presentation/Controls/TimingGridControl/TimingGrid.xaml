<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:behaviors="clr-namespace:SecondMonitor.WindowsControls.WPF.Behaviors;assembly=WindowsControls"
                    xmlns:dataGrid="clr-namespace:SecondMonitor.WindowsControls.WPF.DataGrid;assembly=WindowsControls"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:viewModel="clr-namespace:SecondMonitor.Timing.Application.SessionTiming.Drivers.Presentation.ViewModel"
                    xmlns:timingGridControl="clr-namespace:SecondMonitor.Timing.Application.Presentation.Controls.TimingGridControl"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
                    xmlns:text="clr-namespace:SecondMonitor.WindowsControls.WPF.Text;assembly=WindowsControls"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls"
                    xmlns:pitStatistics="clr-namespace:SecondMonitor.Contracts.PitStatistics;assembly=Contracts"
                    xmlns:pitStops="clr-namespace:SecondMonitor.Timing.Application.SessionTiming.Drivers.Presentation.ViewModel.PitStops"
                    xmlns:tyres="clr-namespace:SecondMonitor.Timing.Application.SessionTiming.Drivers.Presentation.ViewModel.Tyres"
                    xmlns:carSystems="clr-namespace:SecondMonitor.WindowsControls.WPF.CarSystems;assembly=WindowsControls"
                    mc:Ignorable="d">

    <converters:AutoContrastConverter Brush1="{StaticResource LightGrey01Brush}" Brush2="{StaticResource BlackBrush}" x:Key="ContrastConverter" />
    <converters:ValueConverterGroup x:Key="TyreCompoundToForegroundConverter">
        <converters:TyreCompoundToBrushConverter/>
        <converters:BrushToColorDtoConverter/>
        <converters:AutoContrastConverter Brush1="{StaticResource LightGrey01Brush}" Brush2="{StaticResource BlackBrush}"/>
    </converters:ValueConverterGroup>

    <Style x:Key="TextBoxStyleBestLap" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LightGrey01Brush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsLastLapBestLap}" Value="True">
                <Setter Property="Background" Value="{StaticResource Green01Brush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLastLapBestClassSessionLap}" Value="True">
                <Setter Property="Background" Value="{StaticResource PurpleClassTimingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLastLapBestSessionLap}" Value="True">
                <Setter Property="Background" Value="{StaticResource PurpleTimingBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsLastLapTrackRecord}" Value="True">
                <Setter Property="Background" Value="{StaticResource TrackRecordBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsCausingYellow}" Value="True">
                <Setter Property="Background" Value="{StaticResource YellowSectorBrush}" />
                <Setter Property="Foreground" Value="{StaticResource DarkGrey01Brush}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsCausingYellow}" Value="False" />
                    <Condition Binding="{Binding IsLapped}" Value="True" />
                    <Condition Binding="{Binding InPits}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource TimingLappedForegroundBrush}" />
            </MultiDataTrigger>
            <DataTrigger Binding="{Binding IsLapping, Mode=OneWay}" Value="True">
                <Setter Property="Foreground" Value="{StaticResource LightRed02Brush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TextBoxStylePosition" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource LightGrey01Brush}" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding   IsPlayer, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding HighlightPlayer, Mode=OneWay, RelativeSource={RelativeSource AncestorType=timingGridControl:TimingGrid}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="FontSize" Value="{Binding PlayerFontSize, RelativeSource={RelativeSource AncestorType= timingGridControl:TimingGrid}}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="OutlinedTextBoxStylePosition" TargetType="text:OutlinedTextBlock">
        <Setter Property="Fill" Value="{StaticResource LightGrey01Brush}" />
        <Setter Property="Stroke" Value="{StaticResource Anthracite01Brush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding   IsPlayer, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding HighlightPlayer, Mode=OneWay, RelativeSource={RelativeSource AncestorType=timingGridControl:TimingGrid}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="FontSize" Value="{Binding PlayerFontSize, RelativeSource={RelativeSource AncestorType= timingGridControl:TimingGrid}}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StandardTimingGridText" TargetType="TextBlock" BasedOn="{StaticResource StandardText}">
        <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontWeight" Value="{Binding FontWeight, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Setter Property="FontStyle" Value="{Binding FontStyle, RelativeSource={RelativeSource AncestorType=dataGrid:TextCellItem}, Mode=OneTime}" />
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsPlayer, Mode=OneWay}" Value="True" />
                    <Condition Binding="{Binding HighlightPlayer, Mode=OneWay, RelativeSource={RelativeSource AncestorType=timingGridControl:TimingGrid}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <MultiDataTrigger.Setters>
                    <Setter Property="FontSize" Value="{Binding PlayerFontSize, RelativeSource={RelativeSource AncestorType= timingGridControl:TimingGrid}}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </MultiDataTrigger.Setters>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

