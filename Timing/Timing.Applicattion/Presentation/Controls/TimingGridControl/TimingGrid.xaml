    <DataTemplate x:Key="PositionColumnTemplate" DataType="{x:Type viewModel:DriverTimingViewModel}">
        <Grid>
            <Grid Visibility="{Binding IsClassIndicationEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Background="{Binding ClassIndicationBrush, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="4*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Visibility="{Binding IsFinished, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource Anthracite01Brush}">
                    <Rectangle VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,10,10" ViewportUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <GeometryDrawing Geometry="M0,0 H1 V1 H2 V2 H1 V1 H0Z" Brush="White"/>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <Grid Grid.Column="0" Visibility="{Binding DriverTimingAdditionalVisualizationViewModel.ShowPositionGainedArrow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:ColorAbleIcon Grid.Column="0" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Stretch" Stretch="Fill" StrokeBrush="{StaticResource Green01Brush}" MaxWidth="20" MaxHeight="25">
                        <ContentPresenter Content="{StaticResource UpArrow2IconStroked}" />
                    </wpf:ColorAbleIcon>
                </Grid>
                <Grid Grid.Column="0" Visibility="{Binding DriverTimingAdditionalVisualizationViewModel.ShowPositionLostArrow, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <wpf:ColorAbleIcon Grid.Column="0" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Stretch" Stretch="Fill" StrokeBrush="{StaticResource LightRed01Brush}" MaxWidth="20" MaxHeight="25">
                        <ContentPresenter Content="{StaticResource DownArrow2IconStroked}" />
                    </wpf:ColorAbleIcon>
                </Grid>
                <Grid Grid.Column="1">
                    <TextBlock Text="{Binding PositionInClass, Mode=OneWay}" Margin="5,0,0,0" Visibility="{Binding IsClassIndicationEnabled, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Style="{StaticResource TextBoxStylePosition}" />
                    <TextBlock Text="{Binding PositionInClass, Mode=OneWay}"
                               Foreground="{Binding ClassIndicationBrush, Converter={StaticResource ContrastConverter}}"
                               Margin="5,0,0,0" Visibility="{Binding IsClassIndicationEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               Style="{StaticResource TextBoxStylePosition}" />
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type pitStops:NoPitWindowPitViewModel}">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBlock Text="{Binding LastPitInfo, Mode=OneWay}" Margin="0,0,10,0" VerticalAlignment="Center"
                           Style="{StaticResource StandardTimingGridText}" />
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.None}">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.TyresYoungerThanPlayers}">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.TyresOlderThanPlayer}">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.PitStopFasterThanPlayer}">
                                <Setter Property="Background"
                                        Value="{StaticResource DarkRed01Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.PitStopSlowerThanPlayer}">
                                <Setter Property="Background"
                                        Value="{StaticResource Green01Brush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.PitEntry}">
                                <Setter Property="Background"
                                        Value="{StaticResource PitEntryBackground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.InPits}">
                                <Setter Property="Background"
                                        Value="{StaticResource InPitsBackground}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitInfoBriefDescription}"
                                         Value="{x:Static pitStatistics:PitInfoBriefDescriptionKind.PitExit}">
                                <Setter Property="Background"
                                        Value="{StaticResource PitExitBackground}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
            <Grid Grid.Column="2" Visibility="{Binding IsPitStopCountShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding PitStopCount, Mode=OneWay}" HorizontalAlignment="Right" Margin="5,0,5,0" Style="{StaticResource StandardTimingGridText}"
                           VerticalAlignment="Center" />
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PitStopCountGeneralization}"
                                         Value="{x:Static viewModel:PitStopCountGeneralizationKind.None}">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitStopCountGeneralization}"
                                         Value="{x:Static viewModel:PitStopCountGeneralizationKind.SameAsPlayer}">
                                <Setter Property="Background" Value="{StaticResource PitCountEqualPlayers}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitStopCountGeneralization}"
                                         Value="{x:Static viewModel:PitStopCountGeneralizationKind.LessThanPlayer}">
                                <Setter Property="Background" Value="{StaticResource PitCountLessThanPlayers}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PitStopCountGeneralization}"
                                         Value="{x:Static viewModel:PitStopCountGeneralizationKind.MoreThanPLayer}">
                                <Setter Property="Background" Value="{StaticResource PitCountMoreThanPlayers}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
            </Grid>
        </Grid>
    </DataTemplate>

