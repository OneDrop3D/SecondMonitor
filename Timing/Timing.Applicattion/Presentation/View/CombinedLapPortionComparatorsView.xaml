<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
                    xmlns:viewModelsss="clr-namespace:SecondMonitor.Timing.Application.SessionTiming.Drivers.ViewModel">
    
    <DataTemplate  DataType="{x:Type viewModelsss:LapPortionTimesComparatorViewModel}">
        <wpf:TimeSpanBarControl Title="{Binding Title}"
                                AnimateBar="{Binding AnimateDeltaTimes, Mode=OneWay}"
                                HasValidReferenceLap="{Binding HasValidReferenceLap}"
                                Value="{Binding Path=TimeDifference, Mode=OneWay}" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type viewModelsss:LapDeltaViewModel}">
        <Border BorderBrush="{StaticResource Anthracite03Brush}"
                BorderThickness="1" CornerRadius="5">
            <StackPanel>
                <ContentPresenter Content="{Binding TopLapComparatorViewModel}"/>
                <ContentPresenter Content="{Binding BottomLapComparatorViewModel}"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>