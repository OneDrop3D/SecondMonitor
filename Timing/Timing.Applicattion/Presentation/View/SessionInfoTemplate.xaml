<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:viewModel="clr-namespace:SecondMonitor.Timing.Application.ViewModel"
                    xmlns:view="clr-namespace:SecondMonitor.Timing.Application.Presentation.View"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls">
    <view:SectorTimingToStringConverter x:Key="SectorTimingToStringConverter"/>
    <view:BestLapToStringConverter x:Key="BestLapToStringConverter"/>
    <converters:AutoContrastConverter Brush1="{StaticResource LightGrey01Brush}" Brush2="{StaticResource BlackBrush}" x:Key="SessionInfoContrastConverter"/>
    <DataTemplate DataType="{x:Type viewModel:SessionInfoViewModel}">
        <DockPanel Background="{StaticResource Anthracite01Brush}">
            <Border BorderBrush="{StaticResource PurpleTimingBrush}" BorderThickness="2" CornerRadius="6"
                    Visibility="{Binding SelectedBestTimes.AnySectorFilled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" >
                <DockPanel DockPanel.Dock="Left"
                           Visibility="{Binding SelectedBestTimes.AnySectorFilled, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid DockPanel.Dock="Top"
                          Visibility="{Binding SelectedBestTimes.IsSetNameShown, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Background="{Binding SelectedBestTimes.ClassColor, Converter={StaticResource ColorDtoToSolidBrushConverter}}">
                        <TextBlock Text="{Binding SelectedBestTimes.SetLabel}" Style="{StaticResource StandardText}"
                                   Foreground="{Binding SelectedBestTimes.ClassColor, Converter={StaticResource SessionInfoContrastConverter}}" />
                    </Grid>
                    <TextBlock Style="{StaticResource StandardText}"
                               Text="{Binding  SelectedBestTimes.BestSector1, Converter={StaticResource SectorTimingToStringConverter}, ConverterParameter='S1:N/A'}"
                               DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5,5,5,5" />
                    <TextBlock Style="{StaticResource StandardText}"
                               Text="{Binding  SelectedBestTimes.BestSector2, Converter={StaticResource SectorTimingToStringConverter}, ConverterParameter='S2:N/A'}"
                               DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5,5,5,5" />
                    <TextBlock Style="{StaticResource StandardText}"
                               Text="{Binding  SelectedBestTimes.BestSector3, Converter={StaticResource SectorTimingToStringConverter}, ConverterParameter='S3:N/A'}"
                               VerticalAlignment="Top"
                               DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="5,5,5,5" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource PurpleTimingBrush}" BorderThickness="2" CornerRadius="6">
                <DockPanel DockPanel.Dock="Right">
                    <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource BigFontSize}"  Text="{Binding SelectedBestTimes.BestLap, Converter={StaticResource BestLapToStringConverter}}" VerticalAlignment="Top"
                               DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="5,5,5,5" />
                    <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource ExtraBigFontSize}"  Text="{Binding SessionRemaining}" VerticalAlignment="Top"
                               DockPanel.Dock="Top" HorizontalAlignment="Right" Margin="5,5,5,5" Foreground="{StaticResource LightGrey02Brush}" />
                </DockPanel>
            </Border>
        </DockPanel>    
    </DataTemplate>
</ResourceDictionary>