            <DataTemplate DataType="{x:Type viewModel:DashboardSettingsViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Orientation="Vertical" MaxHeight="200" Grid.Row="0">
                    <CheckBox Content="Show ABS"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding AbsEnabled}"/>
                    <CheckBox Content="Show Alternator"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding AlternatorEnabled}"/>
                    <CheckBox Content="Show Bodywork Damage"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding BodyWorkDamageEnabled}"/>
                    <CheckBox Content="Show Brake Damage"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding BrakeDamageEnabled}"/>
                    <CheckBox Content="Show Clutch Damage"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding ClutchDamageEnabled}"/>
                    <CheckBox Content="Show DRS "
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding DrsEnabled}"/>
                    <CheckBox Content="Show Engine Damage "
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding EngineDamageEnabled}"/>
                    <CheckBox Content="Show Ers/Boost "
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding ErsEnabled}"/>
                    <CheckBox Content="Show Gearbox Damage"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding TransmissionDamageEnabled}"/>
                    <CheckBox Content="Show Headlights"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding LightsEnabled}"/>
                    <CheckBox Content="Show Pit Limiter"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding PitLimiterEnabled}"/>
                    <CheckBox Content="Show Suspension Damage"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding SuspensionDamageEnabled}"/>
                    <CheckBox Content="Show TC"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding TcEnabled}"/>
                    <CheckBox Content="Show Tyre Dirt"
                              Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Top"
                              HorizontalAlignment="Left" Margin="5"
                              IsChecked="{Binding TyreDirtEnabled}"/>
                    
