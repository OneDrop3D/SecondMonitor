                            Style="{StaticResource StandardTextBox}"
                            ToolTip="Laps of desired of run time." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Margin="0,2,0,2" Text="Extra Minutes: "
                                   VerticalAlignment="Center"
                                   Style="{StaticResource StandardText}"
                                   ToolTip="Minutes of desired of run time." />
                        <TextBox
                            Text="{Binding ExtraMinutes, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=0}"
