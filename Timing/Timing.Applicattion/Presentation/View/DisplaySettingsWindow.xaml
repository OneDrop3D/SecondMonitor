                                           ToolTip="Interval (in Seconds) defining how long the pit board stays opened" />
                                <TextBox
                                    Text="{Binding PitBoardSettingsViewModel.DisplaySeconds, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5}"
                                    Width="40" Margin="5,3,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="Interval (in Seconds) defining how long the pit board stays opened" />
                            </StackPanel>
                            <CheckBox Content="Yellow Flag Board"
