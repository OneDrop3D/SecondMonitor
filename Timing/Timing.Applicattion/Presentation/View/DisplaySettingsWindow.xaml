<Window x:Class="SecondMonitor.Timing.Application.Presentation.View.DisplaySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:dmBasicProperties="clr-namespace:SecondMonitor.DataModel.BasicProperties;assembly=DataModel"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:viewModel="clr-namespace:SecondMonitor.ViewModels.Settings.ViewModel;assembly=SecondMonitor.ViewModels"
        xmlns:model="clr-namespace:SecondMonitor.ViewModels.Settings.Model;assembly=SecondMonitor.ViewModels"
        xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls"
        xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
        xmlns:units="clr-namespace:SecondMonitor.DataModel.BasicProperties.Units;assembly=DataModel"
        xmlns:donateButton="clr-namespace:SecondMonitor.WindowsControls.WPF.DonateButton;assembly=WindowsControls"
        xmlns:dd="urn:gong-wpf-dragdrop"
        xmlns:dataGrid="clr-namespace:SecondMonitor.ViewModels.DataGrid;assembly=SecondMonitor.ViewModels"
        xmlns:columns="clr-namespace:SecondMonitor.ViewModels.Settings.ViewModel.Columns;assembly=SecondMonitor.ViewModels"
        xmlns:helpButton="clr-namespace:SecondMonitor.WindowsControls.WPF.HelpButton;assembly=WindowsControls"
        xmlns:quantityText="clr-namespace:SecondMonitor.WindowsControls.WPF.QuantityText;assembly=WindowsControls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=viewModel:DisplaySettingsViewModel, IsDesignTimeCreatable=True}"
        Title="SettingsView"
        SizeToContent="WidthAndHeight" MinWidth="650" ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <converters:IntegerToStringConverter x:Key="IntegerToStringConverter" />
            <ObjectDataProvider x:Key="DataFromTemperatureEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:TemperatureUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataFromPressureEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:PressureUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataFromVolumeEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:VolumeUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataFromVelocityEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:VelocityUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataFromDisplayModeEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="model:DisplayModeEnum" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataFromMultiClassDisplayKindEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:MultiClassDisplayKind" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataForForceUnitsEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:ForceUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <ObjectDataProvider x:Key="DataForAngleUnitsEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="dmBasicProperties:AngleUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DataForPowerUnitsEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="units:PowerUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DataForTorqueUnitsEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="units:TorqueUnits" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DataForVerticalAlignmentEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="model:VerticalAlignment" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <ObjectDataProvider x:Key="DataForHorizontalAlignmentEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="model:HorizontalAlignment" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <DataTemplate DataType="{x:Type dataGrid:GenericColumnDescriptorTemplate}">
                <Border BorderBrush="{StaticResource LightGrey01Brush}"
                        BorderThickness="1" Padding="0,0,0,5">
                    <TextBlock Style="{StaticResource StandardText}"
                               VerticalAlignment="Center"
                               Margin="10" Text="{Binding Name}"
                               DockPanel.Dock="Top" />
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:DeltaLapSettingViewModel}">
                <GroupBox Header="Lap Delta" Foreground="{StaticResource LightGrey01Brush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DockPanel.Dock="Left">
                    <StackPanel Orientation="Vertical " Margin="0,0,0,15">
                        <TextBlock Margin="5,5,0,0" Text="Practice: "
                                   FontWeight="Bold"
                                   FontSize="{StaticResource NormalFontSize}"
                                   VerticalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,5,0,5" Width="140"
                                       Text="Top Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Grid.Row="0" Margin="5,5,0,0"  Width="140"
                                       Text="Bottom Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="0" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding PracticeTopLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding PracticeBottomLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                        </Grid>

                        <TextBlock Margin="5,15,0,0" Text="Qualification: "
                                   FontWeight="Bold"
                                   FontSize="{StaticResource NormalFontSize}"
                                   VerticalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,5,0,5" Width="140"
                                       Text="Top Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Grid.Row="0" Margin="5,5,0,0"  Width="140"
                                       Text="Bottom Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="0" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding QualificationTopLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding QualificationBottomLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                        </Grid>

                        <TextBlock Margin="5,15,0,0" Text="Race: "
                                   FontWeight="Bold"
                                   FontSize="{StaticResource NormalFontSize}"
                                   VerticalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Margin="5,5,0,5" Width="140"
                                       Text="Top Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Grid.Row="0" Margin="5,5,0,0"  Width="140"
                                       Text="Bottom Delta Bar" TextAlignment="Center" HorizontalAlignment="Stretch"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="0" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding RaceTopLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                            <Grid Grid.Column="2" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Center" Margin="5,0,0,0" Width="140"
                                          ItemsSource="{Binding AllReferenceKindValues }"
                                          SelectedItem="{Binding RaceBottomLapReferenceKind}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:DisplaySettingsViewModel}" x:Key="SessionSettingsDataTemplate">
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="Session Best" Foreground="{StaticResource LightGrey01Brush}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              DockPanel.Dock="Left">
                        <StackPanel Orientation="Vertical ">

                            <Label Content="Session Best Information:" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0" Foreground="{StaticResource LightGrey01Brush}" />
                            <ComboBox HorizontalAlignment="Left" Margin="0,0,0,5"
                                      VerticalAlignment="Top" Width="250"
                                      ItemsSource="{Binding AllSessionBestInformationKind}"
                                      SelectedItem="{Binding SelectedSessionBestInformationKind}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                        </StackPanel>
                    </GroupBox>
                    <ContentPresenter Content="{Binding DeltaLapSettingViewModel}"/>
                    <GroupBox Header="Track Records" Foreground="{StaticResource LightGrey01Brush}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              DockPanel.Dock="Left">
                        <StackPanel Margin="0,0,0,5">
                            <CheckBox Content="Enabled" Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding TrackRecordsSettingsViewModel.IsEnabled}"
                                      ToolTip="Enables and Disables the track records functionality." />
                            <CheckBox Content="Show session &#x0a;records only"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding TrackRecordsSettingsViewModel.DisplayRecordForCurrentSessionType}"
                                      ToolTip="When enabled only records done in the current session type is shown. i.e. in races you only see records done in race." />

                            <CheckBox Content="Show Average Speed"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding TrackRecordsSettingsViewModel.IsShowAverageSpeedEnabled}"
                                      ToolTip="Show also the average speed in the track records widget." />

                        </StackPanel>
                    </GroupBox>
                    <ContentPresenter Content="{Binding WeatherInfoSettings}" />
                </StackPanel>
            </DataTemplate>


            <DataTemplate DataType="{x:Type viewModel:RestApiSettingsViewModel}">
                <Border BorderBrush="{StaticResource LightGrey01Brush}" BorderThickness="1" Margin="5" Padding="5">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsEnabled}" Margin="5" VerticalAlignment="Center"  VerticalContentAlignment="Center">
                        <TextBlock Style="{StaticResource StandardText}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Text="Enable REST API"/>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StandardText}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Port:" Margin="5"/>
                            <TextBox Width="150" Margin="5" Style="{StaticResource StandardTextBox}" Text="{Binding Port, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5007}"></TextBox>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding IsSwaggerEnabled}" Margin="5" VerticalAlignment="Center"  VerticalContentAlignment="Center">
                            <TextBlock Style="{StaticResource StandardText}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Enable Swagger Page" />
                        </CheckBox>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource StandardText}" Text="Swagger URL:" Margin="5"/>
                            <TextBlock HorizontalAlignment="Center" Margin="5"
                                       Foreground="{StaticResource LightGrey01Brush}"
                                       Grid.ZIndex="2">
                                <Hyperlink Foreground="{StaticResource LightGrey01Brush}"
                                           NavigateUri="{Binding SwaggerUrl}"
                                           RequestNavigate="Hyperlink_OnRequestNavigate">
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding SwaggerUrl}"></TextBlock>
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Style="{StaticResource StandardText}"
                                   VerticalAlignment="Center" FontStyle="Italic"
                                   Margin="10"
                                   Text="Note: All settings in this tab require application restart to take effect"
                                   DockPanel.Dock="Top" />
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:AutoDeleteSettingsViewModel}">
                <Border BorderBrush="{StaticResource LightGrey01Brush}" BorderThickness="1" Margin="5" Padding="5">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource StandardText}"
                               VerticalAlignment="Center"
                               Margin="0,10,10,10" Text="{Binding Title}"
                               DockPanel.Dock="Top" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsDeleteBySizeEnabled}" VerticalAlignment="Center"  VerticalContentAlignment="Center">
                            <TextBlock Style="{StaticResource StandardText}"
                                   VerticalAlignment="Center" TextAlignment="Center"
                                   Text="Delete When Exceeding Size:"/>
                        </CheckBox>
                        <TextBox Style="{StaticResource StandardTextBox}" Text="{Binding MaxMegabytes, Converter={StaticResource IntegerToStringConverter}}" Margin="15,0,0,0" MinWidth="70"/>
                        <TextBlock Style="{StaticResource StandardText}" Text="MB" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0, 5,0,0">
                        <CheckBox IsChecked="{Binding IsDeleteByDaysEnabled}" VerticalAlignment="Center"  VerticalContentAlignment="Center">
                            <TextBlock Style="{StaticResource StandardText}"
                                       VerticalAlignment="Center" TextAlignment="Center"
                                       Text="Delete Files Older Than:"/>
                        </CheckBox>
                        <TextBox Style="{StaticResource StandardTextBox}" Text="{Binding MaxDays, Converter={StaticResource IntegerToStringConverter}}" Margin="15,0,0,0" MinWidth="70"/>
                        <TextBlock Style="{StaticResource StandardText}" Text="Days" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0, 5,0,0">
                        <TextBlock Style="{StaticResource StandardText}" Text="Dir:"/>
                        <TextBox Style="{StaticResource StandardTextBox}" IsReadOnly="True" Margin="5,0,0,0" Text="{Binding Directory}" MinWidth="150"/>
                        <Button Content="..." VerticalContentAlignment="Bottom" Margin="5,0,0,0"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="19"
                                Command="{Binding Path=OpenSelectFolderCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:SimsAutoDeleteSettingsViewModel}">
                <StackPanel Orientation="Vertical">
                    <TextBlock Style="{StaticResource StandardText}"
                               VerticalAlignment="Center"
                               Margin="10" Text="Delete Obsolete Files:"
                               DockPanel.Dock="Top" />
                    <ItemsControl ItemsSource="{Binding AllAutoDeleteSettings}"/>
                </StackPanel>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type viewModel:ChampionshipSettingViewModel}">
                <StackPanel Orientation="Vertical">
                    <GroupBox Header="Running Events" Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Stretch" Grid.Column="0" Padding="5">
                        <CheckBox IsChecked="{Binding IsMultiplayerEnabled}"
                                  Content="Allow Championship Functionality in Multiplayer." Margin="5"
                                  Foreground="{StaticResource LightGrey01Brush}" />
                    </GroupBox>
                    <GroupBox Header="Driver Outlines" Foreground="{StaticResource LightGrey01Brush}"
                              VerticalAlignment="Stretch" Grid.Column="0" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <CheckBox IsChecked="{Binding IsOutlineLeaderEnabled}"
                                      Content="Highlight Championship Leader" Margin="5"
                                      Foreground="{StaticResource LightGrey01Brush}" />
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource StandardText}" Text="Leader Outline Color:" />
                                <Grid Margin="10,0,2,0"
                                      Background="{Binding LeaderOutLine, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}"
                                      Width="30" Height="20" />
                                <xctk:ColorPicker
                                    SelectedColor="{Binding LeaderOutLine, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorDtoToColorConverter}}" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding IsOutLineDriveLessPointsEnabled}"
                                      Content="Highlight Drivers With Less Points" Margin="5,40,0,0"
                                      Foreground="{StaticResource LightGrey01Brush}" />
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource StandardText}" Margin="0,0,5,0"
                                           Text="Max Drivers To Highlight:" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding MaxOutlinedDriveLessPoints, Converter={StaticResource IntegerToStringConverter}, FallbackValue=3}"
                                         Width="30" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource StandardText}" Text="Outline Color From:" />
                                <Grid Margin="10,0,2,0"
                                      Background="{Binding DriverLessPointsOutlineFrom, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}"
                                      Width="30" Height="20" />
                                <xctk:ColorPicker
                                    SelectedColor="{Binding DriverLessPointsOutlineFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorDtoToColorConverter}}" />

                                <TextBlock Margin="40,0,0,0" Style="{StaticResource StandardText}"
                                           Text="Outline Color To:" />
                                <Grid Margin="10,0,2,0"
                                      Background="{Binding DriverLessPointsOutlineTo, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}"
                                      Width="30" Height="20" />
                                <xctk:ColorPicker
                                    SelectedColor="{Binding DriverLessPointsOutlineTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorDtoToColorConverter}}" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding IsOutLineDriverMorePointsEnabled}"
                                      Content="Highlight Drivers With More Points" Margin="5,40,5,5"
                                      Foreground="{StaticResource LightGrey01Brush}" />
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource StandardText}" Margin="0,0,5,0"
                                           Text="Max Drivers To Highlight:" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding MaxOutlinedDriversMorePoints, Converter={StaticResource IntegerToStringConverter}, FallbackValue=3}"
                                         Width="30" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5">
                                <TextBlock Style="{StaticResource StandardText}" Text="Outline Color From:" />
                                <Grid Margin="10,0,2,0"
                                      Background="{Binding DriverMorePointsOutlineFrom, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}"
                                      Width="30" Height="20" />
                                <xctk:ColorPicker
                                    SelectedColor="{Binding DriverMorePointsOutlineFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorDtoToColorConverter}}" />

                                <TextBlock Margin="40,0,0,0" Style="{StaticResource StandardText}"
                                           Text="Outline Color To:" />
                                <Grid Margin="10,0,2,0"
                                      Background="{Binding DriverMorePointsOutlineTo, Converter={StaticResource ColorDtoToSolidBrushConverter}, Mode=OneWay}"
                                      Width="30" Height="20" />
                                <xctk:ColorPicker
                                    SelectedColor="{Binding DriverMorePointsOutlineTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ColorDtoToColorConverter}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5,10,5,5">
                                <TextBlock Style="{StaticResource StandardText}" Margin="0,0,5,0"
                                           Text="Max Points Difference to Highlight:" />
                                <TextBox Width="40" Style="{StaticResource StandardTextBox}"
                                         Text="{Binding MaxPointsDifferenceToOutline, Converter={StaticResource IntegerToStringConverter}, FallbackValue=20}" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </DataTemplate>



            <DataTemplate DataType="{x:Type viewModel:WeatherInfoSettingsViewModel}">
                <GroupBox Header="Temperature Change Info" Foreground="{StaticResource LightGrey01Brush}" Margin="5,5,0,5"
                          VerticalAlignment="Stretch" Grid.Column="0">
                    <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                        <TextBlock Margin="5,5,0,0" Text="Practice / Qualification:"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource NormalFontSize}"
                                   VerticalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Margin="5,5,0,5"
                                       Text="Air Temp Change" TextAlignment="Center"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Grid.Row="0" Grid.ColumnSpan="3" Margin="5,5,0,0"
                                       Text="Track Temp Change" TextAlignment="Center"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="0" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Left" Margin="0,0,0,0" Width="140"
                                          ItemsSource="{Binding AvailableTemperatureChangeValues }"
                                          SelectedItem="{Binding PracticeFirstAirTempInfo}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Grid.Row="1" Margin="2,0,2,0" Text=" / "
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="2" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Left" Margin="0,0,0,0" Width="140"
                                          ItemsSource="{Binding AvailableTemperatureChangeValues }"
                                          SelectedItem="{Binding PracticeSecondAirTempInfo}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>

                            <Grid Grid.Column="4" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Left" Margin="0,0,0,0" Width="140"
                                          ItemsSource="{Binding AvailableTemperatureChangeValues }"
                                          SelectedItem="{Binding PracticeFirstTrackTempInfo}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                            <TextBlock Grid.Column="5" Grid.Row="1" Margin="2,0,2,0" Text=" / "
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
                            <Grid Grid.Column="6" Grid.Row="1">
                                <ComboBox HorizontalAlignment="Left" Margin="0,0,0,0" Width="140"
                                          ItemsSource="{Binding AvailableTemperatureChangeValues }"
                                          SelectedItem="{Binding PracticeSecondTrackTempInfo}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </Grid>
                        </Grid>
                        <TextBlock Margin="5,25,0,5" Text="Race:"
                                   FontWeight="Bold"
                                   FontSize="{StaticResource NormalFontSize}"
                                   VerticalAlignment="Center" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="3" Margin="5,5,0,0"
                                       Text="Air Temp Change" TextAlignment="Center"
                                       FontSize="{StaticResource NormalFontSize}"
                                       VerticalAlignment="Center" />
