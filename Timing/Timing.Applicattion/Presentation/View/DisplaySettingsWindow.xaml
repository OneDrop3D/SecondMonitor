                    <CheckBox Margin="0,5,0,0" IsChecked="{Binding AutoOpenOnSessionStart}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Auto Open on Session Start" Foreground="{StaticResource LightGrey01Brush}"/>
                    <CheckBox Margin="0,5,0,0" IsChecked="{Binding AutoOpenWhenInPits}" VerticalAlignment="Center" Content="Auto Open when In Pits" Foreground="{StaticResource LightGrey01Brush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
