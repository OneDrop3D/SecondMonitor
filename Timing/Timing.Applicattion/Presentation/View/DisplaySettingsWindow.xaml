                                <StackPanel Orientation="Vertical" Margin="20,0,0,0">
                                    <TextBlock Margin="0,5,0,0" Text="Vertical Position"
                                               Style="{StaticResource StandardText}" />
                                    <ComboBox HorizontalAlignment="Left" Margin="0,2,0,0"
                                              Width="94"
                                              ItemsSource="{Binding Source={StaticResource DataForVerticalAlignmentEnum}}"
                                              SelectedItem="{Binding PitBoardSettingsViewModel.VerticalAlignment}"
                                              Style="{StaticResource StandardComboBoxStyle}" />
                                </StackPanel>
