                                      ToolTip="Enables and Disables the board informing about distance to yellow" />
                            <CheckBox Content="Pit Duration Pit Board"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding PitBoardSettingsViewModel.IsPitDurationBoardEnabled}"
                                      ToolTip="Enables and Disables the board showing the duration of current pit stop" />
                            <CheckBox Content="Pit Entry Speed Pit Board"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding PitBoardSettingsViewModel.IsPitEntrySpeedBoardEnabled}"
                                      ToolTip="Enables and Disables the board showing speed on pit entry" />
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="0,5,0,0" Text="Horizontal Position"
                                               Style="{StaticResource StandardText}" />
                                    <ComboBox HorizontalAlignment="Left" Margin="0,2,0,0"
                                              Width="94"
                                              ItemsSource="{Binding Source={StaticResource DataForHorizontalAlignmentEnum}}"
                                              SelectedItem="{Binding PitBoardSettingsViewModel.HorizontalAlignment}"
                                              Style="{StaticResource StandardComboBoxStyle}" />
