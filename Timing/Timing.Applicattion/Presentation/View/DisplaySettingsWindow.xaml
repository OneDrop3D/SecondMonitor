                            Text="{Binding TcAndAbsTimeout, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=8}"
                            Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                            Style="{StaticResource StandardTextBox}"
                            ToolTip="Seconds, during which the ABS/TC icon will be blue colored, after ABS/TC activation.." />
                    </StackPanel>

                    </StackPanel>
                </Grid>
