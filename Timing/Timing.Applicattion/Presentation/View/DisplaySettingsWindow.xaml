                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Pit Estimation" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <ContentPresenter Content="{Binding PitEstimationSettingsViewModel}"/>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Car Info" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="Car Info." Foreground="{StaticResource LightGrey01Brush}"
                              DockPanel.Dock="Left">
                        <StackPanel>
                            <CheckBox Content="Enable Pedal and Gear"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding EnablePedalInformation}"
                                      ToolTip="Enables and Disables updates for pedals and gear panel." />
                            <CheckBox Content="Enable Temp. Info"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding EnableTemperatureInformation}"
                                      ToolTip="Enables and Disables the updates of panels with temperature information." />
                            <CheckBox Content="Enable non. Temp. Info"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding EnableNonTemperatureInformation}"
                                      ToolTip="Enables and Disables updates of panels with information other than temperature information." />
                            <CheckBox Content="Enable camber visualization"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding EnableCamberVisualization}"
                                      ToolTip="Enables and Disables the camber visualization on the tyres controls." />
                            <CheckBox Content="Show Recent Lowest Speed"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsRecentLowestSpeedEnabled}"
                                      ToolTip="Enables or Disables the display of recent lowest speed." />
                            <CheckBox Content="Show Recent Highest Speed"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsRecentHighestSpeedEnabled}"
                                      ToolTip="Enables or Disables the display of recent highest speed." />
                            <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                <TextBlock Margin="0,5,0,0" Text="Speed Display Time (seconds)" VerticalAlignment="Center"
                                           Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}"
                                           ToolTip="Slowest / Highest timeout Interval" />
                                <TextBox
                                    Text="{Binding LowestHighestSpeedTimeout, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=10}"
                                    Width="40" Margin="5,3,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="Interval (in Seconds) defining how long it should take for the highest / lowest speed to time out" />
                            </StackPanel>
                            <CheckBox Content="Show Bottom Out Indicator"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsBottomingOutIndicationEnabled}"
                                      ToolTip="Enables or Disables the display of car bottoming out." />
                            <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                <TextBlock Margin="0,0,0,0" Text="Bottom Out Height: " VerticalAlignment="Center"
                                           Style="{StaticResource StandardText}"
                                           FontSize="{StaticResource SmallFontSize}"
                                           ToolTip="Minimal car height, before the bottom out indicator is shown" />
                                <quantityText:DistanceText HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           FontSize="{StaticResource SmallFontSize}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource LightGrey01Brush}"
                                                           Width="100"
                                                           IsReadonly="False"
                                                           ShowUnitSymbol="True"
                                                           ToolTip="Minimal car height, before the bottom out indicator is shown"
                                                           Quantity="{Binding BottomingOutHeight, Mode=TwoWay}"
                                                           DistanceUnits="{Binding DistanceUnitsVerySmall, Mode=OneWay}" />
                            </StackPanel>
                            <GroupBox Header="Dashboard Icons" Foreground="{StaticResource LightGrey01Brush}">
                                <ContentPresenter Content="{Binding DashboardSettingsViewModel}" />
                            </GroupBox>

                        </StackPanel>
                    </GroupBox>

                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Fuel Calculator" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <StackPanel>
                        <GroupBox Header="Pre-Race Fuel Calculation" Foreground="{StaticResource LightGrey01Brush}"
                                  DockPanel.Dock="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Initial Extra Fuel (%) to Use"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Extra Fuel to use for automatic calculations when no previous race session for the car/track combo found" />
                                    <TextBox
                                        Text="{Binding MaximumExtraFuel, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=15}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Extra Fuel to use for automatic calculations when no previous race session for the car/track combo found" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Minimal Extra Fuel (%) to Use"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Extra Fuel to use for automatic calculations when enough previous race session for the car/track combo are stored" />
                                    <TextBox
                                        Text="{Binding MinimumExtraFuel, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Extra Fuel to use for automatic calculations when enough previous race session for the car/track combo are stored" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Required Races To Use Minimal Extra Fuel "
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="How many races are for each car/track combo are required to use the minimal extra fuel value" />
                                    <TextBox
                                        Text="{Binding RacesToTrainFuel, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="How many races are for each car/track combo are required to use the minimal extra fuel value" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Pit Stop Fuel Calculation" Foreground="{StaticResource LightGrey01Brush}"
                                  DockPanel.Dock="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Extra Laps"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Extra Laps of Fuel to add, atop of what is automatically estimated" />
                                    <TextBox
                                        Text="{Binding ExtraRaceLaps, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=1}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Extra Laps of Fuel to add, atop of what is automatically estimated" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Extra Minutes"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Extra Minutes of Fuel to add, atop of what is automatically estimated" />
                                    <TextBox
                                        Text="{Binding ExtraRaceMinutes, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=0}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Extra Minutes of Fuel to add, atop of what is automatically estimated" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="5,2,0,2">
                                    <TextBlock Margin="0,2,0,2" Text="Contingency fuel (%)"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Extra Contingency Fuel to, atop of what is automatically estimated" />
                                    <TextBox
                                        Text="{Binding ExtraContingencyFuel, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=15}"
                                        Width="40" Margin="5,2,0,2" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Extra Contingency Fuel to, atop of what is automatically estimated" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Practice Fuel Calculation" Foreground="{StaticResource LightGrey01Brush}"
                                  DockPanel.Dock="Left" Padding="5">
                            <ContentPresenter Content="{Binding PracticeFuelSettings}"/>
                        </GroupBox>
                        <GroupBox Header="Qualification Fuel Calculation" Foreground="{StaticResource LightGrey01Brush}"
                                  DockPanel.Dock="Left" Padding="5">
                            <ContentPresenter Content="{Binding QualificationFuelSettings}"/>
                        </GroupBox>
                        <GroupBox Header="Race Fuel Calculation" Foreground="{StaticResource LightGrey01Brush}"
                                  DockPanel.Dock="Left" Padding="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0">
                                    <StackPanel Orientation="Vertical">
                                        <TextBlock Margin="0,2,0,2" Text="Lap Races"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource StandardText}"/>
                                        <ContentPresenter Content="{Binding LapRaceSessionFuelSetting}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Grid.Column="1">
                                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                                </StackPanel>

                                <Grid Grid.Column="2">
                                    <StackPanel Orientation="Vertical">
                                    <TextBlock Margin="0,2,0,2" Text="Timed Races"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource StandardText}"/>
                                    <ContentPresenter Content="{Binding TimedRaceSessionFuelSettings}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Reports" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="Report Options" Foreground="{StaticResource LightGrey01Brush}"
                              DockPanel.Dock="Top">
                        <DockPanel>
                            <GroupBox DockPanel.Dock="Top" Margin="0,8,0,0" Header="General">
                                <StackPanel
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    Margin="0,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Label HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Foreground="{StaticResource LightGrey01Brush}"
                                               Content="Maximum Reports:" Height="27" />
                                        <xctk:IntegerUpDown HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Minimum="1"
                                                            Maximum="9999" Text=""
                                                            Value="{Binding ReportingSettingsViewModel.MaximumReports, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Foreground="{StaticResource LightGrey01Brush}"
                                                            Background="{StaticResource DarkGrey01Brush}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Foreground="{StaticResource LightGrey01Brush}"
                                               Content="Minimum Session (minutes):" Height="27" Width="165" />
                                        <xctk:IntegerUpDown HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Minimum="1"
                                                            Maximum="100" Text=""
                                                            Value="{Binding ReportingSettingsViewModel.MinimumSessionLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Foreground="{StaticResource LightGrey01Brush}"
                                                            Background="{StaticResource DarkGrey01Brush}" />
                                    </StackPanel>
                                    <CheckBox Content="Also Export .Json File"
                                              Foreground="{StaticResource LightGrey01Brush}"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left" Margin="5"
                                              IsChecked="{Binding ReportingSettingsViewModel.ExportJson}"
                                              ToolTip="Whenever a xlsx file is export, a additional .json file, containing the same data, will be exported as well." />
                                </StackPanel>
                            </GroupBox>
                            <Label DockPanel.Dock="Top" Content="Practice:" HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                            <ContentPresenter DockPanel.Dock="Top"
                                              Content="{Binding ReportingSettingsViewModel.PracticeReportSettingsView}" />

                            <Label DockPanel.Dock="Top" Content="Qualification:" HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                            <ContentPresenter DockPanel.Dock="Top"
                                              Content="{Binding ReportingSettingsViewModel.QualificationReportSettingView}" />

                            <Label DockPanel.Dock="Top" Content="Warm Up:" HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                            <ContentPresenter DockPanel.Dock="Top"
                                              Content="{Binding ReportingSettingsViewModel.WarmUpReportSettingsView}" />

                            <Label DockPanel.Dock="Top" Content="Race:" HorizontalAlignment="Left"
                                   Margin="0,8,0,0"
                                   VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                            <ContentPresenter DockPanel.Dock="Top"
                                              Content="{Binding ReportingSettingsViewModel.RaceReportSettingsView}" />
                        </DockPanel>
                    </GroupBox>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Telemetry" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="Telemetry" Foreground="{StaticResource LightGrey01Brush}"

                              DockPanel.Dock="Top">
                        <StackPanel>
                            <CheckBox Content="Enable Telemetry" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.IsTelemetryLoggingEnabled}" />
                            <CheckBox Content="Save also XML file" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.IsSaveAlsoAsXMlEnabled}" />
                            <CheckBox Content="Save also JSON file" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.IsSaveAlsoAsJsonEnabled}" />
                            <CheckBox Content="Log in Practice Session" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogInPractice}" />
                            <CheckBox Content="Log in Qualification Session" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogInQualification}" />
                            <CheckBox Content="Log in Race Session" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogInRace}" />
                            <CheckBox Content="Log Invalid Laps" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogInvalidLaps}" />
                            <CheckBox Content="Log Opponents Best" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,15,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogOpponentsBest}" />
                            <CheckBox Content="Log Best for Each Driver" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogBestForEachDriver}" />
                            <CheckBox Content="Log only Player class" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogOnlyPlayerClass}" />
                            <CheckBox Content="Log All Opponents Laps" Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="5,5,0,0"
                                      IsChecked="{Binding TelemetrySettingsViewModel.LogOpponentsAll}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Text="{Binding TelemetrySettingsViewModel.LogOnlyTop, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=10}"
                                    Style="{StaticResource StandardTextBox}" VerticalAlignment="Center"
                                    Width="40" Margin="5,5,0,0"
                                    ToolTip="Opponent needs to be in better place than this number to log his telemetry information (conserves memory) " />
                                <TextBlock Margin="5,5,0,0" Text="Log only opponents in TOP x Position" Style="{StaticResource StandardText}"
                                           ToolTip="Opponent needs to be in better place than this number to log his telemetry information (conserves memory) " />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Text="{Binding TelemetrySettingsViewModel.LoggingInterval, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=50}"
                                    Style="{StaticResource StandardTextBox}" VerticalAlignment="Center"
                                    Width="40" Margin="5,5,0,0"
                                    ToolTip="Interval (in MS) defining how often the app should log the telemetry information." />
                                <TextBlock Margin="5,5,0,0" Text="Telemetry Data Interval (ms)" Style="{StaticResource StandardText}"
                                           ToolTip="Interval (in MS) defining how often the app should log the telemetry information." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox
                                    Text="{Binding TelemetrySettingsViewModel.MaxSessionsKept, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=10}"
                                    Width="40" Margin="5,5,0,0" Style="{StaticResource StandardTextBox}" VerticalAlignment="Center"
                                    ToolTip="Defines How Many Sessions, at maximum, should be kept stored. If the number is exceeded, then the application if automatically delete the oldest telemetry data." />
                                <TextBlock Margin="5,5,0,0" Text="Maximum Sessions Stored"
                                           Style="{StaticResource StandardText}"
                                           ToolTip="Defines How Many Sessions, at maximum, should be kept stored. If the number is exceeded, then the application if automatically delete the oldest telemetry data." />
                            </StackPanel>
                        </StackPanel>

                    </GroupBox>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Rating" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="Rating" Foreground="{StaticResource LightGrey01Brush}" DockPanel.Dock="Left">
                        <StackPanel>
                            <CheckBox Content="Enable Rating"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding RatingSettingsViewModel.IsEnabled}"
                                      ToolTip="Enables and Disables the rating application module." />
                            <TextBlock Style="{StaticResource StandardText}" Text="Rating Reference:"
                                       FontSize="{StaticResource SmallFontSize}" Margin="5,10,0,2" />
                            <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,5,0"
                                      Width="120"
                                      ItemsSource="{Binding RatingSettingsViewModel.AvailableReferenceRatingProviders}"
                                      SelectedItem="{Binding RatingSettingsViewModel.SelectedReferenceRatingProvider}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                            <TextBlock Style="{StaticResource StandardText}" Text="Grace Laps:"
                                       FontSize="{StaticResource SmallFontSize}" Margin="5,10,0,2" />
                            <TextBox Style="{StaticResource StandardTextBox}" HorizontalAlignment="Left"
                                     Text="{Binding RatingSettingsViewModel.GraceLapsCount, Converter={StaticResource NonNegativeIntToStringConverter}}"
                                     FontSize="{StaticResource SmallFontSize}" Margin="5,0,0,5" Width="50" />
                            <TextBlock Style="{StaticResource StandardText}" Text="Normalized Field Size:"
                                       FontSize="{StaticResource SmallFontSize}" Margin="5,10,0,2"
                                       ToolTip="Scales rating changes to the field of this size. In practice it increases computed rating changed for field that are smaller than this and decreases for fields bigger. 0 is disabled. " />
                            <TextBox Style="{StaticResource StandardTextBox}" HorizontalAlignment="Left"
                                     ToolTip="Scales rating changes to the field of this size. In practice it increases computed rating changed for field that are smaller than this and decreases for fields bigger. 0 is disabled. "
                                     Text="{Binding RatingSettingsViewModel.NormalizedFieldSize, Converter={StaticResource NonNegativeIntToStringConverter}}"
                                     FontSize="{StaticResource SmallFontSize}" Margin="5,0,0,5" Width="50" />
                            <TextBlock Style="{StaticResource StandardText}" Text="K factor"
                                       FontSize="{StaticResource SmallFontSize}" Margin="5,10,0,2"
                                       ToolTip="Defines K factor of the elo algorithm. This affects rate at which rating changes. Lower K values will result in less rating gained or lost. Default value is 15." />
                            <StackPanel Orientation="Horizontal">
                            <Slider Minimum="5" Maximum="50"
                                    Value="{Binding RatingSettingsViewModel.EloK}"
                                    TickFrequency="5" TickPlacement="BottomRight" Width="160"
                                    HorizontalAlignment="Left"
                                    ToolTip="Defines K factor of the elo algorithm. This affects rate at which rating changes. Lower K values will result in less rating gained or lost. Default value is 15." />
                            <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                       Text="{Binding RatingSettingsViewModel.EloK, Converter={StaticResource IntegerToStringConverter}}"
                                       HorizontalAlignment="Center" ToolTip="Defines K factor of the elo algorithm. This affects rate at which rating changes. Lower K values will result in less rating gained or lost. Default value is 15." />
                            </StackPanel>
                            <TextBlock Style="{StaticResource StandardText}" Text="Competitive AI Range"
                                       FontSize="{StaticResource SmallFontSize}" Margin="5,10,0,2"
                                       ToolTip="Defines how many AI difficulty levels above your assumed level should you still be competitive with the AI." />
                            <StackPanel Orientation="Horizontal">
                                <Slider Minimum="1" Maximum="5"
                                        Value="{Binding RatingSettingsViewModel.AiCompetitiveRange}"
                                        TickFrequency="0.1" Width="160"
                                        HorizontalAlignment="Left"
                                        IsSnapToTickEnabled="True"
                                        ToolTip="Defines how many AI difficulty levels above your assumed level should you still be competitive with the AI. " />
                                <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                           Text="{Binding RatingSettingsViewModel.AiCompetitiveRange, Converter={StaticResource DoubleToScalableDecimalsConverter}}"
                                           HorizontalAlignment="Center" ToolTip="Defines K factor of the elo algorithm. This affects rate at which rating changes. Lower K values will result in less rating gained or lost. Default value is 15." />
                            </StackPanel>
                            <helpButton:HelpButton HelpUrl="https://gitlab.com/winzarten/SecondMonitor/-/wikis/Rating-Settings" VerticalAlignment="Top" HorizontalAlignment="Right" Width="50" Height="50"/>
                        </StackPanel>
                    </GroupBox>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Championships" Margin="5"
                       HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <ContentPresenter Content="{Binding ChampionshipSettingViewModel}"/>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Resources" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <StackPanel>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,0" VerticalAlignment="Top"
                                       Style="{StaticResource StandardText}"
                                       Foreground="{StaticResource LightGrey01Brush}"
                                       Text="Custom Color Resources:" />
                            <TextBox TextWrapping="Wrap" Margin="0,0,0,0" VerticalAlignment="Top"
                                     Style="{StaticResource StandardTextBox}"
                                     Background="{StaticResource Anthracite05Brush}" IsReadOnly="True"
                                     FontSize="{StaticResource SmallFontSize}"
                                     Foreground="{StaticResource LightGrey01Brush}" MaxWidth="600"
                                     Text="Path for custom color resources that will overwrite the default color scheme. Check the wiki how to write them." />
                            <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     IsReadOnly="True"
                                     Text="{Binding CustomResourcesPath, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}" />
                            <Button Content="..." VerticalContentAlignment="Center" Margin="5" Height="21"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Width="19"
                                    Command="{Binding Path=SelectCustomResourceFileCommand}" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Margin="0,0,0,0" VerticalAlignment="Top"
                                       Style="{StaticResource StandardText}"
                                       Foreground="{StaticResource LightGrey01Brush}"
                                       Text="User Files Path:" />
                            <TextBox TextWrapping="Wrap" Margin="0,0,0,0" VerticalAlignment="Top"
                                     Style="{StaticResource StandardTextBox}"
                                     Background="{StaticResource Anthracite05Brush}" IsReadOnly="True"
                                     FontSize="{StaticResource SmallFontSize}"
                                     Foreground="{StaticResource LightGrey01Brush}" MaxWidth="600"
                                     Text="This includes stored maps, telemetry, car settings info and reports. Changing this will not move the existing files to a new locations. Application restart after changing this settings is advisable." />
                            <TextBox HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                     IsReadOnly="True"
                                     Text="{Binding ReportingSettingsViewModel.ExportDirectoryReplacedSpecialDirs, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StandardTextBox}" />
                            <Button Content="..." VerticalContentAlignment="Center" Margin="5"  
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="19"
                                    Command="{Binding Path=ReportingSettingsViewModel.SelectExportDirCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Logs" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                <Button Height="55"
                                        Command="{Binding OpenLogDirectoryCommand}"
                                        Style="{StaticResource StandardButton}"
                                        ToolTip="Opens the log directory">
                                    <Button.Content>
                                        <wpf:ColorAbleIcon Margin="5,5,5,5"
                                                           StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource FolderIcon}" />
                                        </wpf:ColorAbleIcon>
                                    </Button.Content>

                                </Button>
                                <TextBlock Margin="5,5,0,0" Text="Open Log directory"
                                           Style="{StaticResource StandardText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <donateButton:DonateButton DockPanel.Dock="Bottom" />
                    </StackPanel>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" ToolTip="Various settings for Sims">
                        <TextBlock Style="{StaticResource StandardText}" Text="Sim Settings" Margin="5" />
                    </Grid>
                </TabItem.Header>
                <Grid>
                    <ContentPresenter Content="{Binding PluginsConfigurationViewModel}" />
                </Grid>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" ToolTip="Settings for auto deleting stored sim files, like replays or saved games">
                        <TextBlock Style="{StaticResource StandardText}" Text="Obsolete Files Removal" Margin="5" />
                    </Grid>
                </TabItem.Header>
                <Grid>
                    <ContentPresenter Content="{Binding SimsAutoDeleteSettingsViewModel}" />
                </Grid>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" ToolTip="Layout">
                        <TextBlock Style="{StaticResource StandardText}" Text="Layout" Margin="5" />
                    </Grid>
                </TabItem.Header>
                <Grid>
                    <ContentPresenter Content="{Binding LayoutEditorViewModel}" />
                </Grid>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" ToolTip="Settings for enabling other apps to connect to and retrieve second monitor data.">
                        <TextBlock Style="{StaticResource StandardText}" Text="Rest API" Margin="5" />
                    </Grid>
                </TabItem.Header>
                <Grid>
                    <ContentPresenter Content="{Binding RestApiSettingsViewModel}" />
                </Grid>
            </TabItem>
            <TabControl.Resources>
                <Style TargetType="{x:Type TabPanel}">
                    <Setter Property="Background" Value="{StaticResource Anthracite01Brush}" />
                </Style>
            </TabControl.Resources>
        </TabControl>

    </Grid>
</Window>