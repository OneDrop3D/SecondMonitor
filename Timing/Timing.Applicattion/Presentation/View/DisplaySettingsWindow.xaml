            <DataTemplate DataType="{x:Type viewModel:PitEstimationVisualizationSettingsViewModel}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsPitBoardEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="PitBoard" Foreground="{StaticResource LightGrey01Brush}" Margin="0,0,40,0"/>
                        <CheckBox IsChecked="{Binding IsMapEnabled}" VerticalAlignment="Center" Content="Map" Foreground="{StaticResource LightGrey01Brush}"/>
                    </StackPanel>
                </StackPanel>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:PitEstimationSettingsViewModel}">
                <GroupBox Header="Pit Estimation" Foreground="{StaticResource LightGrey01Brush}"
                          VerticalAlignment="Stretch" Grid.Column="0">
                    <Grid>
                        <helpButton:HelpButton HelpUrl="https://gitlab.com/winzarten/SecondMonitor/-/wikis/Pit-Estimations" VerticalAlignment="Top" HorizontalAlignment="Right" Width="50" Height="50"/>
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,50">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="5,5,0,0" Text="Show When:"
                                           FontSize="{StaticResource BigFontSize}"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="5,5,0,0" Text="Show On:"
                                           FontSize="{StaticResource BigFontSize}"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="5,5,0,0" Text="Always:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="1" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding AlwaysEnabled}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="5,5,0,0" Text="Pit Requested:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="2" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding PitRequested}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="5,5,0,0" Text="In Pit Widow:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="3" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding InPitWindow}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="5,5,0,0" Text="Fuel Low:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="4" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding FuelLow}" VerticalAlignment="Center" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="5,5,0,0" Text="Tyre Worn:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="5" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding TyreWorn}" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="0" Margin="5,5,0,0" Text="Stint Ending:"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Row="6" Grid.Column="2" Margin="5,5,0,0"
                                                  Content="{Binding StintEnding}" VerticalAlignment="Center" />
                            </Grid>
                            <CheckBox IsChecked="{Binding ShowPitBoardAtEntry}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Show pit estimation board at pit entry: " Foreground="{StaticResource LightGrey01Brush}"
                                      Margin="0,3,5,0" FontSize="{StaticResource NormalFontSize}"/>
                            
                                <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                    <TextBlock Margin="0,5,0,0" Text="Show when Fuel less than"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Enables pit return position estimation when less than the given laps of fuel remain." />
                                    <TextBox
                                        Text="{Binding LapsRemaining, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5}"
                                        Width="40" Margin="5,5,0,0" HorizontalAlignment="Left"
                                        Style="{StaticResource StandardTextBox}"
                                        ToolTip="Enables pit return position estimation when less than the given laps of fuel remain." />
                                    <TextBlock Margin="0,5,0,0" Text="Laps"
                                               Style="{StaticResource StandardText}"
                                               ToolTip="Enables pit return position estimation when less than the given laps of fuel remain." />
                                </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                <TextBlock Margin="0,5,0,0" Text="Show when Tyre wear more than"
                                           Style="{StaticResource StandardText}"
                                           ToolTip="Enables pit return position estimation when tyre wear of any tyre is more than given %." />
                                <TextBox
                                    Text="{Binding TyreWear, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=50}"
                                    Width="40" Margin="5,5,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="Enables pit return position estimation when tyre wear of any tyre is more than given %." />
                                <TextBlock Margin="0,5,0,0" Text="%"
                                           Style="{StaticResource StandardText}"
                                           ToolTip="Enables pit return position estimation when tyre wear of any tyre is more than given %." />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                <TextBlock Margin="0,5,0,0" Text="Extra Time"
                                           Style="{StaticResource StandardText}"
                                           ToolTip="Time to add in addition to estimated pit lost. This is to compensate to time lost outside of the pit lane (breaking into pits, acceleration, compromised line through first corner)" />
                                <TextBox
                                    Text="{Binding ExtraTime, Converter={StaticResource DoubleToScalableDecimalsConverter}, ConverterParameter=1}"
                                    Width="40" Margin="5,5,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="Time to add in addition to estimated pit lost." />
                                <TextBlock Margin="0,5,0,0" Text="seconds"
                                           Style="{StaticResource StandardText}"
                                           ToolTip="Time to add in addition to estimated pit lost. This is to compensate to time lost outside of the pit lane (breaking into pits, acceleration, compromised line through first corner)" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="5,15,0,0">
                                <CheckBox IsChecked="{Binding IsOverridePitStallTimeEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Override Pit Stall Duration to: " Foreground="{StaticResource LightGrey01Brush}"
                                          Margin="0,3,5,0" FontSize="{StaticResource NormalFontSize}"/>
                                <TextBox
                                    Text="{Binding OverridePitStallTime, Converter={StaticResource DoubleToScalableDecimalsConverter}, ConverterParameter=1}"
                                    Width="40" Margin="5,3,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="If you know actual time spent in stall, enter it here." VerticalAlignment="Center"/>
                                <TextBlock Margin="5,3,0,0" Text="seconds"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                           ToolTip="If you know actual time spent in stall, enter it here." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="5,5,0,0">
                                <CheckBox IsChecked="{Binding IsOverridePitLaneTimeEnabled}" VerticalAlignment="Center" VerticalContentAlignment="Center" Content="Override Pit Lane Lost Time to: " Foreground="{StaticResource LightGrey01Brush}"
                                          Margin="0,3,5,0" FontSize="{StaticResource NormalFontSize}"/>
                                <TextBox
                                    Text="{Binding OverridePitLaneTime, Converter={StaticResource DoubleToScalableDecimalsConverter}, ConverterParameter=1}"
                                    Width="40" Margin="5,3,0,0" HorizontalAlignment="Left"
                                    Style="{StaticResource StandardTextBox}"
                                    ToolTip="If you know actual time lost in pit lane (excluding the stop time), enter it here." VerticalAlignment="Center"/>
                                <TextBlock Margin="5,3,0,0" Text="seconds"
                                           Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                           ToolTip="If you know actual time lost in pit lane (excluding the stop time), enter it here." />
                            </StackPanel>
                        </StackPanel>

                    </Grid>
                </GroupBox>
            </DataTemplate>

            <DataTemplate DataType="{x:Type columns:ColumnsSettingsViewModel}">
                <Grid>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalAlignment="Stretch"
                              VerticalScrollBarVisibility="Disabled">
                    <ListBox Background="{StaticResource Anthracite05Brush}" ItemsSource="{Binding ColumnDescriptorViewModels}" dd:DragDrop.IsDragSource="True"  dd:DragDrop.IsDropTarget="True"  dd:DragDrop.DropHandler="{Binding }">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <DockPanel LastChildFill="False" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </ScrollViewer>
                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:SessionOptionsViewModel}">
                <Border BorderBrush="{StaticResource LightGrey01Brush}" BorderThickness="1" Padding="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="1080" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Label Content="Display Times" VerticalAlignment="Top" Margin="5,0,0,0" Foreground="{StaticResource LightGrey01Brush}" />
                            <ComboBox HorizontalAlignment="Left" Margin="0,0,0,0" Width="94"
                                      ItemsSource="{Binding Source={StaticResource DataFromDisplayModeEnum}}"
                                      SelectedItem="{Binding TimesDisplayMode}"
                                      Style="{StaticResource StandardComboBoxStyle}"  />
                            <Label Content="Drivers Order" VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0" />
                            <ComboBox HorizontalAlignment="Left" Margin="5,0,0,0"  Width="94"
                                      ItemsSource="{Binding AvailableOrderingModes}"
                                      SelectedItem="{Binding SelectedOrderingMode}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                            <CheckBox Foreground="{StaticResource LightGrey01Brush}"
                                      Content="Highlight player" Margin="5,5,0,0"
                                      IsChecked="{Binding HighlightPlayer}" HorizontalContentAlignment="Left" />
                            <Label Content="Player Font size" VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0" />
                            <TextBox Margin="5,2,25,10" Style="{StaticResource StandardTextBox}" Text="{Binding HighlightFontSize, Converter={StaticResource IntegerToStringConverter}}"/>

                        </StackPanel>
                        <Grid Grid.Column="1">
                            <ContentPresenter Content="{Binding ColumnsSettingsViewModel}"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:SessionsOptionsViewModel}">
                <Grid Background="{StaticResource Anthracite05Brush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Columns Visibility" Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Stretch" Grid.Column="0">
                            <StackPanel VerticalAlignment="Stretch">
                                <Label DockPanel.Dock="Top" Content="Practice:" HorizontalAlignment="Left"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                                <ContentPresenter DockPanel.Dock="Top"
                                                  Content="{Binding PracticeSessionDisplayOptionsView}" />

                                <Label DockPanel.Dock="Top" Content="Qualification:" HorizontalAlignment="Left"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                                <ContentPresenter DockPanel.Dock="Top"
                                                  Content="{Binding QualificationSessionDisplayOptionsView}" />

                                <Label DockPanel.Dock="Top" Content="Race:" HorizontalAlignment="Left"
                                       Margin="0,8,0,0"
                                       VerticalAlignment="Top" Foreground="{StaticResource LightGrey01Brush}" />
                                <ContentPresenter DockPanel.Dock="Top"
                                                  Content="{Binding RaceSessionDisplayOptionsView}" />
                            </StackPanel>
                        </GroupBox>
                        <Grid Grid.Column="1" MaxHeight="700">
                            <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey01Brush}">
                                <DockPanel>
                                    <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center"
                                               FontSize="{StaticResource BigFontSize}" Margin="10,10,10,0"
                                               Text="Available Columns:" DockPanel.Dock="Top" />
                                    <TextBlock Style="{StaticResource StandardText}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                               Margin="3"
                                               Text="(Drag and Drop)" DockPanel.Dock="Top" FontSize="{StaticResource SmallFontSize}" />
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ListBox BorderThickness="0" Foreground="{StaticResource Anthracite01Brush}"
                                                 DockPanel.Dock="Bottom"
                                                 Background="{StaticResource Anthracite01Brush}"
                                                 ItemsSource="{Binding AvailableColumns }" Width="220"
                                                 dd:DragDrop.IsDragSource="True" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="1" BorderThickness="1" BorderBrush="{StaticResource LightGrey01Brush}"
                            Background="{StaticResource Anthracite02Brush}">
                        <DockPanel LastChildFill="False">
                            <Button Height="55" Margin="5" DockPanel.Dock="Left"
                                    Command="{Binding RevertToDefaultCommand}"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="Resets to default columns settings.">
                                <Button.Content>
                                    <wpf:ColorAbleIcon
                                        StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Content="{StaticResource ResetSettings}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            <Button Height="55" Margin="5" DockPanel.Dock="Right"
                                    Command="{Binding ApplyColumnsCommand}"
                                    Style="{StaticResource StandardButton}"
                                    ToolTip="Applies the layout.">
                                <Button.Content>
                                    <wpf:ColorAbleIcon Margin="0"
                                                       StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Content="{StaticResource OkIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                        </DockPanel>
                    </Border>

                </Grid>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModel:SessionReportSettingsViewModel}">
                <Border BorderBrush="{StaticResource LightGrey01Brush}" BorderThickness="1" Padding="0,0,0,5">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Foreground="{StaticResource LightGrey01Brush}"
                                  Content="- Export" Margin="10,8,0,10"
                                  IsChecked="{Binding Export}" HorizontalContentAlignment="Left" />
                        <CheckBox DockPanel.Dock="Right" Foreground="{StaticResource LightGrey01Brush}"
                                  Content="- Auto Open" Margin="10,8,0,10"
                                  IsChecked="{Binding AutoOpen}" HorizontalContentAlignment="Left" />
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="{StaticResource Anthracite01Brush}">
        <TabControl Background="{StaticResource Anthracite01Brush}" TabStripPlacement="Left">
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource StandardText}" Text="Timing Grid" Margin="5" />
                    </Grid>
                </TabItem.Header>
                <GroupBox Header="Timing Grid" Foreground="{StaticResource LightGrey01Brush}"
                          HorizontalAlignment="Stretch"
                          DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="10,0,10,5" Grid.Column="0">
                            <Label Content="Pace Laps:" HorizontalAlignment="Left" VerticalAlignment="Top"
                                   Foreground="{StaticResource LightGrey01Brush}" />
                            <xctk:IntegerUpDown x:Name="UpDownPaceLaps" VerticalAlignment="Top" Minimum="1"
                                                Maximum="10"
                                                Text="" Margin="0,0,15,0"
                                                Value="{Binding PaceLaps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Foreground="{StaticResource LightGrey01Brush}"
                                                Background="{StaticResource DarkGrey01Brush}" />
                            <GroupBox Header="Laps until Gap Closed estimation" Foreground="{StaticResource LightGrey01Brush}"
                                      BorderThickness="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      DockPanel.Dock="Left">
                                <StackPanel Margin="10,0,10,5" Grid.Column="0">
                                    <CheckBox Content="Enable Laps to Until Gap is Closed Estimation"
                                              Foreground="{StaticResource LightGrey01Brush}"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left" Margin="0,10,0,0"
                                              IsChecked="{Binding PaceContainsLapsToCatchEstimation}"
                                              ToolTip="Adds an estimate of how many laps will it take to catch the driver in front, or how many laps would it take for the car behind to catch the player." />
                                    <CheckBox Content="Compute Only on Lap Start"
                                              Foreground="{StaticResource LightGrey01Brush}"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Left" Margin="0,10,0,0"
                                              IsChecked="{Binding GapComputeOnlyOnLapStart}"
                                              ToolTip="If checked, the lap estimation will be computed only on lap start. This is to avoid the estimation jumping a lot because the gap is changing throughout the lap." />
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                        <TextBlock Margin="0,5,5,0" Text="Start after x minutes have passed:"
                                                   ToolTip="Estimation will start after initial x minutes after session start."
                                                   VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding GapClosingInitialTime, Converter={StaticResource DoubleToScalableDecimalsConverter}, ConverterParameter=5.0}"
                                                 VerticalAlignment="Center"
                                                 Width="40" Margin="0,5,0,0"
                                                 ToolTip="Estimation will start after initial x minutes after session start."/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                        <TextBlock Margin="0,5,5,0" Text="Maximum pos difference for estimation"
                                                   ToolTip="Number of position in front/behind the gap closure estimation is computed."
                                                   VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding GapClosingMaximumPositionDifference, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=4}"
                                                 VerticalAlignment="Center"
                                                 Width="40" Margin="0,5,0,0"
                                                 ToolTip="Number of position in front/behind the gap closure estimation is computed." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                        <TextBlock Margin="0,5,5,0" Text="Time lost per overtake (seconds):"
                                                   ToolTip="Estimated time lost for each overtake. Used in calculating how many laps until gap is closed."
                                                   VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding GapClosingOvertakeTimeLost, Converter={StaticResource DoubleToScalableDecimalsConverter}, ConverterParameter=2.0}"
                                                 VerticalAlignment="Center"
                                                 Width="40" Margin="0,5,0,0"
                                                 ToolTip="Estimated time lost for each overtake. Used in calculating how many laps until gap is closed." />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">

                                        <TextBlock Margin="0,5,5,0" Text="Maximum laps after race finish"
                                                   ToolTip="Do not show laps necessary for gap closure if the gap is estimated to close x laps after the race finishes"
                                                   VerticalAlignment="Center" />
                                        <TextBox Style="{StaticResource StandardTextBox}"
                                                 Text="{Binding GapClosingExtraLaps, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=5}"
                                                 VerticalAlignment="Center"
                                                 Width="40" Margin="0,5,0,0"
                                                 ToolTip="Do not show laps necessary for gap closure if the gap is estimated to close x laps after the race finishes" />
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            <Label Content="Refresh Rate:" HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Foreground="{StaticResource LightGrey01Brush}" />
                            <xctk:IntegerUpDown x:Name="UpDownRefreshRate" VerticalAlignment="Top"
                                                Minimum="50"
                                                Maximum="5000" Margin="0,0,15,0"
                                                Text="" Value="{Binding RefreshRate}" Increment="50"
                                                Foreground="{StaticResource LightGrey01Brush}"
                                                Background="{StaticResource DarkGrey01Brush}" />
                            <CheckBox Content="Scroll to Player"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding ScrollToPlayer}" />
                            <CheckBox Content="Animate Delta Bar"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding AnimateDeltaTimes}"
                                      ToolTip="Enables and Disables the fluid animation of delta times bars. Disable to lower CPU usage of application." />
                            <Label Content="MultiClass Display Mode:" HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Margin="0,10,0,0" Foreground="{StaticResource LightGrey01Brush}" />
                            <ComboBox HorizontalAlignment="Left"
                                      VerticalAlignment="Top" Width="94"
                                      ItemsSource="{Binding Source={StaticResource DataFromMultiClassDisplayKindEnum}}"
                                      SelectedItem="{Binding MultiClassDisplayKind}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                            <CheckBox Content="Force Single Class"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsForceSingleClassEnabled}"
                                      ToolTip="Force the race to be single class, even if more classes are present. (Might require session reset)" />
                            <StackPanel Orientation="Horizontal">

                                <TextBlock Margin="0,5,5,0" Text="Drivers refreshed per tick:"
                                           ToolTip="Number of drivers updated on grid and map per one refresh tick (does not affect data precision). Can be used to lower application cpu usage in larger fields."
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding DriversUpdatedPerTick, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=500}"
                                         VerticalAlignment="Center"
                                         Width="40" Margin="0,5,0,0"
                                         ToolTip="Number of drivers updated on grid and map per one refresh tick (does not affect data precision). Can be used to lower application cpu usage in larger fields. " />
                            </StackPanel>
                            <TextBlock Margin="0,10,5,0" Text="Pit Stop Time to Show:"
                                       ToolTip="What time should be displayed in the timing grid pit column."
                                       VerticalAlignment="Center" />
                            <ComboBox HorizontalAlignment="Left" Margin ="0,5,0,0"
                                      VerticalAlignment="Top" Width="94"
                                      ItemsSource="{Binding AllowedPitStopDisplayModes}"
                                      SelectedItem="{Binding SelectedPitStopDisplayMode}"
                                      Style="{StaticResource StandardComboBoxStyle}" />
                            <CheckBox Content="Show Pit Stop Time as Difference"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding ShowPitStopTimeRelative}"
                                      ToolTip="Should the pit stop time for opponents be displayed as time difference between players pit stop time, or not" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                        </StackPanel>
                        <StackPanel Margin="10,0,10,5" Grid.Column="2">
                            <TextBlock Margin="0,5,0,0" Text="Hybrid mode settings:"
                                       FontSize="{StaticResource BigFontSize}"
                                       VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Margin="0,5,5,0" Text="Close driver window boundary ahead (second):"
                                           ToolTip="If drivers are in front of player, and within this boundary, they will be considered close to player, and ordered relative in hybrid mode."
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding HybridModeRelativeInFront, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=8}"
                                         VerticalAlignment="Center"
                                         Width="40" Margin="0,5,0,0"
                                         ToolTip="If drivers are in front of player, and within this boundary, they will be considered close to player, and ordered relative in hybrid mode." />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBlock Margin="0,5,5,0" Text="Close driver window boundary behind (second):"
                                           ToolTip="If drivers are in behind of player, and within this boundary, they will be considered close to player, and ordered relative in hybrid mode."
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding HybridModeRelativeInBehind, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=8}"
                                         VerticalAlignment="Center"
                                         Width="40" Margin="0,5,0,0"
                                         ToolTip="If drivers are in behind of player, and within this boundary, they will be considered close to player, and ordered relative in hybrid mode." />
                            </StackPanel>
                            <CheckBox Content="Hybrid mode Grid Gap Enabled"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsHybridModeGapEnabled}"
                                      ToolTip="Enables/Disables the Gap in timing grid separating the relative part of grid from the absolute"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                                <TextBlock Margin="0,5,5,0" Text="Hybrid mode Gap Size:"
                                           ToolTip="Height of the gap in the timing grid separating relative and absolute ordered drivers."
                                           VerticalAlignment="Center" />
                                <TextBox Style="{StaticResource StandardTextBox}"
                                         Text="{Binding HybridModeGapHeight, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=30}"
                                         VerticalAlignment="Center"
                                         Width="40" Margin="0,5,0,0"
                                         ToolTip="Height of the gap in the timing grid separating relative and absolute ordered drivers." />
                            </StackPanel>
                            <TextBlock Margin="0,5,0,0" Text="Gap Visualization Settings:"
                                       FontSize="{StaticResource BigFontSize}"
                                       VerticalAlignment="Center" />
                            <CheckBox Content="Enable Gap Visualization"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="0,10,0,0"
                                      IsChecked="{Binding IsGapVisualizationEnabled}" />
                            <TextBlock HorizontalAlignment="Left"
                                       Foreground="{StaticResource LightGrey01Brush}"
                                       Text="Gap (seconds)with no gap visualization:" />
                            <TextBox Style="{StaticResource StandardTextBox}"
                                     Text="{Binding MinimalGapForVisualization, Converter={StaticResource DoubleToScalableDecimalsConverter}}" />
                            <Label HorizontalAlignment="Left"
                                   Foreground="{StaticResource LightGrey01Brush}"
                                   Content="Gap height for each seconds:" />
                            <TextBox Style="{StaticResource StandardTextBox}"
                                     Text="{Binding GapHeightForOneSecond, Converter={StaticResource DoubleToScalableDecimalsConverter}}" />
                            <Label HorizontalAlignment="Left"
                                   Foreground="{StaticResource LightGrey01Brush}"
                                   Content="Maximum Gap Height:" />
                            <TextBox Style="{StaticResource StandardTextBox}"
                                     Text="{Binding MaximumGapHeight, Converter={StaticResource DoubleToScalableDecimalsConverter}}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource StandardText}" Text="Columns" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <ContentPresenter Content="{Binding SessionOptionsViewModel}" />
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Session Info" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <ContentPresenter Content="{Binding .}" ContentTemplate="{StaticResource SessionSettingsDataTemplate}"></ContentPresenter>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Map" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <GroupBox Header="Map Options" Foreground="{StaticResource LightGrey01Brush}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          DockPanel.Dock="Left">
                    <StackPanel Margin="0,0,0,5">
                        <CheckBox Content="Animate Drivers Pos."
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding AnimateDriversPosition}"
                                  ToolTip="Enables and Disables the fluid animation of drivers in the circle maps. Disable to lower CPU usage of application." />
                        <CheckBox Content="Scale Drivers"
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding MapDisplaySettingsViewModel.AutoScaleDrivers}"
                                  ToolTip="Sets if drivers icons should be scaled with the map. If checked the drivers icons will always be the same size. If unchecked driver icon will always be with scale to the map - always 25 meters." />
                        <CheckBox Content="Keep Map Ratio"
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding MapDisplaySettingsViewModel.KeepMapRatio}"
                                  ToolTip="If enabled the map will always keep the ratio. If unchecked the map will fill the whole available space, at the cost of distortion." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource StandardTextBox}"
                                     Text="{Binding MapDisplaySettingsViewModel.MapPointsInterval, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=500}"
                                     Width="40" Margin="0,5,0,0"
                                     ToolTip="Interval (in MS) defining how often the app should take the drivers position when creating a new map for unknown track. (default is 500ms)" />
                            <TextBlock Margin="5,5,0,0" Text="Points interval"
                                       ToolTip="Interval (in MS) defining how often the app should take the drivers position when creating a new map for unknown track. (default is 500ms)" />
                        </StackPanel>
                        <CheckBox Content="Show Pit Count Information"
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding MapDisplaySettingsViewModel.ShowPitsInformation}"
                                  ToolTip="Shows additional information about the drivers pit stop count on the bottom part of the driver icon." />
                        <CheckBox Content="Always Use Circle"
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding MapDisplaySettingsViewModel.AlwaysUseCirce}"
                                  ToolTip="Forces the app to always use the circle instead of a track map." />
                        <CheckBox Content="Show in Separate Window"
                                  Foreground="{StaticResource LightGrey01Brush}"
                                  VerticalAlignment="Top"
                                  HorizontalAlignment="Left" Margin="0,10,0,0"
                                  IsChecked="{Binding MapDisplaySettingsViewModel.RenderMapInSeparateWindow}"
                                  ToolTip="Forces the map to be rendered in separate window." />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource StandardTextBox}"
                                     Text="{Binding MapDisplaySettingsViewModel.DriverScalePercentage, Converter={StaticResource IntegerToStringConverter}, ConverterParameter=8}"
                                     Width="40" Margin="0,5,0,0"
                                     ToolTip="% of screen size the driver representation should be on track map, if autoscaling is enabled" />
                            <TextBlock Margin="5,5,0,0" Text="Drivers Scale (%)"
                                       ToolTip="% of screen size the driver representation should be on track map, if autoscaling is enabled" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="UOM" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="UOM" Foreground="{StaticResource LightGrey01Brush}"
                              DockPanel.Dock="Left">
                        <WrapPanel Orientation="Vertical">
                            <StackPanel>
                                <Label Content="Temperature" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" FontWeight="Bold"
                                       Foreground="{StaticResource LightGrey01Brush}" />
                                <ComboBox HorizontalAlignment="Left"
                                          VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataFromTemperatureEnum}}"
                                          SelectedItem="{Binding TemperatureUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Pressure" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" FontWeight="Bold"
                                       Foreground="{StaticResource LightGrey01Brush}" />
                                <ComboBox HorizontalAlignment="Left"
                                          VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataFromPressureEnum}}"
                                          SelectedItem="{Binding PressureUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                                <CheckBox Content="Force PSI in ACC"
                                          Foreground="{StaticResource LightGrey01Brush}"
                                          VerticalAlignment="Top"
                                          HorizontalAlignment="Left" Margin="5,10,0,0"
                                          IsChecked="{Binding OverrideToPsiInAcc}"
                                          ToolTip="Forces PSI usage in ACC" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Volume" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="{StaticResource LightGrey01Brush}" FontWeight="Bold" />
                                <ComboBox HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataFromVolumeEnum}}"
                                          SelectedItem="{Binding VolumeUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Velocity" HorizontalAlignment="Left"
                                       VerticalAlignment="Top" FontWeight="Bold"
                                       Foreground="{StaticResource LightGrey01Brush}" />
                                <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataFromVelocityEnum}}"
                                          SelectedItem="{Binding VelocityUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Force" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="{StaticResource LightGrey01Brush}" FontWeight="Bold" />
                                <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataForForceUnitsEnum}}"
                                          SelectedItem="{Binding ForceUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Angle" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="{StaticResource LightGrey01Brush}" FontWeight="Bold" />
                                <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataForAngleUnitsEnum}}"
                                          SelectedItem="{Binding AngleUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Power" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="{StaticResource LightGrey01Brush}" FontWeight="Bold" />
                                <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataForPowerUnitsEnum}}"
                                          SelectedItem="{Binding PowerUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                            <StackPanel>
                                <Label Content="Torque" HorizontalAlignment="Left" VerticalAlignment="Top"
                                       Foreground="{StaticResource LightGrey01Brush}" FontWeight="Bold" />
                                <ComboBox HorizontalAlignment="Left" VerticalAlignment="Top" Width="94"
                                          ItemsSource="{Binding Source={StaticResource DataForTorqueUnitsEnum}}"
                                          SelectedItem="{Binding TorqueUnits}"
                                          Style="{StaticResource StandardComboBoxStyle}" />
                            </StackPanel>
                        </WrapPanel>
                    </GroupBox>
                </Border>
            </TabItem>
            <TabItem Background="{StaticResource Anthracite01Brush}">
                <TabItem.Header>
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <TextBlock Style="{StaticResource StandardText}" Text="Pit Board" Margin="5"
                                   HorizontalAlignment="Stretch" />
                    </Grid>
                </TabItem.Header>
                <Border Padding="5">
                    <GroupBox Header="Pit Board" Foreground="{StaticResource LightGrey01Brush}"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              DockPanel.Dock="Left">
                        <StackPanel Margin="0,0,0,5">
                            <CheckBox Content="Gap change pitboard"
                                      Foreground="{StaticResource LightGrey01Brush}"
                                      VerticalAlignment="Top"
                                      HorizontalAlignment="Left" Margin="5,10,0,0"
                                      IsChecked="{Binding PitBoardSettingsViewModel.IsEnabled}"
                                      ToolTip="Enables and Disables the end of lap pit board" />
                            <CheckBox Content="Limit gap change to player class"
