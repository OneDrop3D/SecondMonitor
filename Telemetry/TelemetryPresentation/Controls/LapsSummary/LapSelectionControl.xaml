<UserControl x:Class="SecondMonitor.TelemetryPresentation.Controls.LapsSummary.LapSelectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lapPicker="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.LapPicker;assembly=TelemetryApplication"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
             xmlns:lapsSummary="clr-namespace:SecondMonitor.TelemetryPresentation.Controls.LapsSummary"
             xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"  d:DataContext="{d:DesignInstance Type=lapPicker:LapSelectionViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../TelemetryPresentation.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToColorConverter x:Key="IsLapValidToBrushConverter" TrueBrush="{StaticResource LightGrey01Brush}" FalseBrush="{StaticResource DarkRed01Brush}"/>
            <DataTemplate DataType="{x:Type lapPicker:LapSummaryViewModel}">
                <Border Margin="5" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1"
                                    CornerRadius="3" Padding="5">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" SharedSizeGroup="LapTimeGroup" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="35" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Margin="5,0,5,0"
                                                  VerticalAlignment="Center" />
                            <!--<TextBlock Style="{StaticResource StandardText}" Text="Lap: " VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
                            <TextBlock Style="{StaticResource StandardText}" Grid.Column="1"
                                                   Text="{Binding DriverName}" Visibility="{Binding IsDriverNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center" Margin="5" />
                            <TextBlock Grid.Column="2" Style="{StaticResource StandardText}"
                                       Margin="10,0,0,0"
                                       Text="{Binding LapTime, Mode=OneWay, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <Grid Grid.Column="3" Height="20" Width="20"
                                              Background="{Binding LapColorBrush}" Margin="5,0,2,0" />
                            <xctk:ColorPicker Grid.Column="4" Margin="0,4,5,4"
                                              SelectedColor="{Binding LapColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox Grid.Column="5" Style="{StaticResource StandardComboBoxStyle}"
                                                  SelectedItem="{Binding Stint}"
                                                  ItemsSource="{Binding AvailableStintGroups}" Margin="0,4,0,4" />

                            <Button Grid.Column="6" HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding RemoveLapCommand}"
                                                ToolTip="Remove Lap"
                                                Style="{StaticResource StandardButton}">
                                <Button.Content>
                                    <wpf:ColorAbleIcon
                                                    StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}"
                                                    Margin="-2">
                                        <ContentPresenter Content="{StaticResource CancelIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            <Button Grid.Column="7" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding ShowTelemetryChecklist}"
                                                ToolTip="Shows the Setup Check for this Lap"
                                                Visibility="{Binding IsPlayerLap, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{StaticResource StandardButton}">
                                <Button.Content>
                                    <wpf:ColorAbleIcon
                                                    StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}"
                                                    Margin="-2">
                                        <ContentPresenter Content="{StaticResource ChecklistIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            <TextBlock Style="{StaticResource StandardText}" Grid.Column="8"
                                       Text="{Binding CustomName}" VerticalAlignment="Center"
                                       Foreground="{Binding IsValid, Converter={StaticResource IsLapValidToBrushConverter}}"
                                       HorizontalAlignment="Center" />

                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="25" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource StandardText}"
                                                   Margin="0,0,0,0" Text="S1: " VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="{StaticResource SmallFontSize}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource StandardText}"
                                                   Margin="0,0,0,0"
                                                   Text="{Binding Sector1Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   FontSize="{StaticResource SmallFontSize}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource StandardText}"
                                                   Margin="5,0,0,0" Text="S2: " VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="{StaticResource SmallFontSize}" />
                            <TextBlock Grid.Column="3" Style="{StaticResource StandardText}"
                                                   Margin="0,0,5,0"
                                                   Text="{Binding Sector2Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   FontSize="{StaticResource SmallFontSize}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource StandardText}"
                                                   Margin="0,0,0,0" Text="S3: " VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   FontSize="{StaticResource SmallFontSize}" />
                            <TextBlock Grid.Column="5" Style="{StaticResource StandardText}"
                                                   Margin="0,0,0,0"
                                                   Text="{Binding Sector3Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                                   FontSize="{StaticResource SmallFontSize}" />
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="LapsAsTreeViewTemplate">
                <Grid>
                    <TreeView ItemsSource="{Binding LapSummariesFiltered.Groups}" Background="{StaticResource Anthracite01Brush}">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type CollectionViewGroup}"
                                                      ItemsSource="{Binding Items}">
                                <Grid>
                                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding Name}" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </DataTemplate>
            <DataTemplate x:Key="LapsAsListTemplate">
                 <ListBox Grid.IsSharedSizeScope="True" Foreground="{StaticResource LightGrey01Brush}" Background="{StaticResource Anthracite01Brush}" SelectionMode="Single" SelectedItem="{Binding Selected, Mode=TwoWay}" ItemsSource="{Binding LapSummaries}" DockPanel.Dock="Top"/>
            </DataTemplate>
            <lapsSummary:LapSelectionTemplateSelectorConverter x:Key="LapSelectionTemplateSelector" ListViewDataTemplate="{StaticResource LapsAsListTemplate}" TreeViewDataTemplate="{StaticResource LapsAsTreeViewTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}" Padding="5" HorizontalAlignment="Stretch" >
        <Grid Background="{StaticResource Anthracite01Brush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="5,10,10,0">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Name: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox Style="{StaticResource StandardTextBox}" Width="250" Text="{Binding SessionName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Simulator: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding SimulatorName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Date: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding SessionTime, Converter={StaticResource DateTimeToCurrentConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Track: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding TrackName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Car: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding CarName}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Best Lap: " VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding BestLap}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Best S1: " VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource SmallFontSize}"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding BestSector1}" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="{StaticResource SmallFontSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Best S2: " VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource SmallFontSize}"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding BestSector2}" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="{StaticResource SmallFontSize}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource StandardText}" Text="Best S3: " VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="{StaticResource SmallFontSize}"/>
                    <TextBlock Style="{StaticResource StandardText}" Text="{Binding BestSector3}" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="{StaticResource SmallFontSize}"/>
                </StackPanel>
                <Border BorderThickness="1" CornerRadius="5" Margin="0,10,0,0" BorderBrush="{StaticResource DarkGrey05Brush}">
                    <StackPanel Orientation=" Horizontal" VerticalAlignment="Bottom" >
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Click="OpenButton_OnClick"
                            Style="{StaticResource StandardButton}"
                            ToolTip="Opens another telemetry session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource FolderIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Click="AddButton_OnClick"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Add Another telemetry session to currently opened session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource FolderPlusIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding SaveSessionCommand}" IsEnabled="{Binding IsSaveButtonEnabled}"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Saves the opened telemetry session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource SaveIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding SaveAsNewSessionCommand}" IsEnabled="{Binding IsSaveButtonEnabled}"
                                Style="{StaticResource StandardButton}"
                                ToolTip="Saves the opened telemetry as a new archived session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource SavePlusIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding ExportSessionCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Export the Opened Session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource ExportIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding ImportSessionCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Import a Session">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource ImportIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding OpenCarSettingsCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Open Car Settings Window">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource CarSettingsIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="40" HorizontalAlignment="Right" HorizontalContentAlignment="Stretch" Command="{Binding OpenSettingsWindowCommand}"
                                Style="{StaticResource StandardButton}">
                            <Button.Content>
                                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" Margin="-2">
                                    <ContentPresenter Content="{StaticResource SettingsIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Grid Grid.Row="1" Margin="0,5,0,0">
                <ContentPresenter Content="{Binding .}" ContentTemplate="{Binding AreLapsGrouped, Converter={StaticResource  LapSelectionTemplateSelector}}" />
            </Grid>
            <DockPanel Grid.Row="2" DockPanel.LastChildFill="False" DockPanel.Dock="Top">
                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" DockPanel.Dock="Left" Width="16" Margin="5,0,0,0" Height="20">
                    <ContentPresenter Content="{StaticResource SortIcon}" />
                </wpf:ColorAbleIcon>
                <ComboBox Style="{StaticResource StandardComboBoxStyle}" SelectedItem="{Binding SelectedSortingKind}" VerticalContentAlignment="Center" HorizontalContentAlignment="Left"
                          ItemsSource="{Binding AllowedSortingKinds}" Width="200"  Margin="0,5,0,5"/>
                
                <Button Width="25" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" DockPanel.Dock="Right"
                        Command="{Binding OpenLapChartCommand}"
                        Style="{StaticResource StandardButton}" ToolTip="Opens the laps chart.">
                    <Button.Content>
                        <wpf:ColorAbleIcon Margin="-5"
                                           StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                            <ContentPresenter Content="{StaticResource TelemetryIcon }" />
                        </wpf:ColorAbleIcon>
                    </Button.Content>
                </Button>

                <TextBox  Style="{StaticResource StandardTextBox}" Margin="5" MinWidth="40" Text="{Binding QuickSearchText, UpdateSourceTrigger=PropertyChanged}"  DockPanel.Dock="Right"/>
                <wpf:ColorAbleIcon StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}" DockPanel.Dock="Right" Width="16" Margin="5">
                    <ContentPresenter Content="{StaticResource SearchIcon}" />
                </wpf:ColorAbleIcon>

            </DockPanel>
            <DockPanel LastChildFill="False" Grid.Row="3">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                Command="{Binding AddCustomLapCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Add a custom lap from disk.">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="-5"
                                                   StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource PlusIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                Command="{Binding OpenAggregatedChartSelectorCommand}"
                                IsEnabled="{Binding IsOpenAggregatedChartSelectorEnabled, Mode=OneWay}"
                                Style="{StaticResource StandardButton}" ToolTip="Opens aggregated charts selector.">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="-5"
                                                   StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource TelemetryIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBlock Text="Ref. Lap:" Style="{StaticResource StandardText}" Margin="0,0,0,0"
                               VerticalAlignment="Center" />
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" ItemsSource="{Binding SelectedLaps}"
                              SelectedItem="{Binding ReferenceLap}" Margin="5,0,0,0" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type lapPicker:ILapSummaryViewModel}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource StandardText}"
                                                Text="{Binding CustomName}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                Command="{Binding LoadAllLapsCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Load all laps.">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="-5"
                                                   StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource AllIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                Command="{Binding UnloadAllLapsCommand}"
                                Style="{StaticResource StandardButton}" ToolTip="Unload all laps.">
                            <Button.Content>
                                <wpf:ColorAbleIcon Margin="-5"
                                                   StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                    <ContentPresenter Content="{StaticResource NoneIcon}" />
                                </wpf:ColorAbleIcon>
                            </Button.Content>
                        </Button>
                        <ComboBox Style="{StaticResource StandardComboBoxStyle}" SelectedItem="{Binding SelectedStint}" ItemsSource="{Binding AvailableStints}" Width="60" Height="25"/>
                    </StackPanel>

            </DockPanel>
        </Grid>
    </Border>
</UserControl>
