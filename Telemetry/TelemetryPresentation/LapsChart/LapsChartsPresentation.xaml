<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lapsChart="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.LapsChart;assembly=TelemetryApplication"
                    xmlns:lapPicker="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.LapPicker;assembly=TelemetryApplication"
                    xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls"
                    xmlns:wpf="http://oxyplot.org/skiawpf"
                    xmlns:wpf1="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls">

    <converters:BoolToColorConverter x:Key="IsLapValidToBrushConverter" TrueBrush="{StaticResource LightGrey01Brush}"
                                     FalseBrush="{StaticResource DarkRed01Brush}" />

    <DataTemplate DataType="{x:Type lapsChart:LapsChartViewModel}">
        <Grid>
            <wpf:PlotView Model="{Binding PlotModel}"/>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type lapPicker:LapSummaryViewModel}" x:Key="LapChartsLapSummaryViewModelTemplate">
        <Border Margin="5" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1"
                CornerRadius="3" Padding="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ItemGroupSize"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="0" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" SharedSizeGroup="LapTimeGroup" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected}" Margin="5,0,5,0"
                              VerticalAlignment="Center" />
                    <!--<TextBlock Style="{StaticResource StandardText}" Text="Lap: " VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
                    <TextBlock Style="{StaticResource StandardText}" Grid.Column="1"
                               Text="{Binding DriverName}"
                               Visibility="{Binding IsDriverNameVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" Margin="5" />
                    <TextBlock Grid.Column="2" Style="{StaticResource StandardText}"
                               Margin="10,0,0,0"
                               Text="{Binding LapTime, Mode=OneWay, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                    <Grid Grid.Column="3" Height="20" Width="20"
                          Background="{Binding LapColorBrush}" Margin="5,0,2,0" />

                    <TextBlock Style="{StaticResource StandardText}" Grid.Column="4"
                               Text="{Binding CustomName}" VerticalAlignment="Center"
                               Foreground="{Binding IsValid, Converter={StaticResource IsLapValidToBrushConverter}}"
                               HorizontalAlignment="Center" />

                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="25" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Style="{StaticResource StandardText}"
                               Margin="0,0,0,0" Text="S1: " VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SmallFontSize}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource StandardText}"
                               Margin="0,0,0,0"
                               Text="{Binding Sector1Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="{StaticResource SmallFontSize}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource StandardText}"
                               Margin="5,0,0,0" Text="S2: " VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SmallFontSize}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource StandardText}"
                               Margin="0,0,5,0"
                               Text="{Binding Sector2Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="{StaticResource SmallFontSize}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource StandardText}"
                               Margin="0,0,0,0" Text="S3: " VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="{StaticResource SmallFontSize}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource StandardText}"
                               Margin="0,0,0,0"
                               Text="{Binding Sector3Time, Mode=OneWay, Converter={StaticResource TimeSpanToSecondsNoSignConverter}, ConverterParameter=3}"
                               VerticalAlignment="Center" HorizontalAlignment="Left"
                               FontSize="{StaticResource SmallFontSize}" />
                </Grid>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type lapsChart:LapsChartWindowViewModel}">
        <Grid Background="{StaticResource Anthracite01Brush}" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="1000" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <ContentPresenter Content="{Binding LapsChartViewModel}"/>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Border Margin="5" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1"
                            CornerRadius="3" Padding="5">
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Best Lap Time:"
                                           Margin="0,0,20,0" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding BestLapTime, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Worst Lap Time:"
                                           Margin="0,0,20,0" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding WorstLapTime, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding WorsLapTimeDifference, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}, StringFormat={}  (+{0})}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Mean Lap Time:"
                                           Margin="0,0,20,0" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding MeanLapTime, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                            </StackPanel>
                            
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Median Lap Time:"
                                           Margin="0,0,20,0" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding MedianLapTime, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource StandardText}" Text="Std Deviation:"
                                           Margin="0,0,20,0" />
                                <TextBlock Style="{StaticResource StandardText}"
                                           Text="{Binding StdDeviation, Converter={StaticResource TimeSpanToMinutesSecondMilisecondsConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Border Margin="5" BorderBrush="{StaticResource DarkGrey01Brush}" BorderThickness="1"
                            CornerRadius="3" Padding="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" IsSharedSizeScope="True">
                                <ListBox Grid.Row="0" Grid.IsSharedSizeScope="True" Foreground="{StaticResource LightGrey01Brush}"
                                         Background="{StaticResource Anthracite01Brush}" SelectionMode="Single"
                                         ItemTemplate="{StaticResource LapChartsLapSummaryViewModelTemplate}"
                                         
                                         ItemsSource="{Binding AllLapSummaryViewModels}" DockPanel.Dock="Top" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Grid.Row="1">
                                <Grid>
                                    <ComboBox Style="{StaticResource StandardComboBoxStyle}" SelectedItem="{Binding SelectedDriverName}"
                                          ItemsSource="{Binding AllDriverNames}" Width="250" Margin="0,0,5,0" VerticalAlignment="Center" />
                                </Grid>
                                <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                        Command="{Binding SelectAllLapsCommand}"
                                        Style="{StaticResource StandardButton}" ToolTip="Load all laps.">
                                    <Button.Content>
                                        <wpf1:ColorAbleIcon Margin="-5"
                                                           StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource AllIcon}" />
                                        </wpf1:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                                <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch"
                                        Command="{Binding DeselectAllLapsCommand}"
                                        Style="{StaticResource StandardButton}" ToolTip="Unload all laps.">
                                    <Button.Content>
                                        <wpf1:ColorAbleIcon Margin="-5"
                                                           StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                            <ContentPresenter Content="{StaticResource NoneIcon}" />
                                        </wpf1:ColorAbleIcon>
                                    </Button.Content>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>