<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:wpf="clr-namespace:SecondMonitor.WindowsControls.WPF;assembly=WindowsControls"
                    xmlns:scatterPlot="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.AggregatedCharts.ScatterPlot;assembly=TelemetryApplication"
                    xmlns:behavior="clr-namespace:SecondMonitor.TelemetryPresentation.Behavior"
                    xmlns:wpf1="http://oxyplot.org/skiawpf"
                    xmlns:b="http://schemas.microsoft.com/xaml/behaviors">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../TelemetryPresentation.xaml" />
        <ResourceDictionary>
            <DataTemplate DataType="{x:Type scatterPlot:FilteredScatterPlotChartViewModel}">
                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey05Brush}">
                     <Grid Background="{StaticResource Anthracite01Brush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource StandardText}"
                                       Text="{Binding DataPointsCount, StringFormat=Data Points: {0}}" Grid.ZIndex="2"
                                       VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <wpf1:PlotView Model="{Binding PlotModel}">
                                <b:Interaction.Behaviors>
                                    <behavior:ScatterPlotSelectionByDragBehavior ScatterPlotChartViewModel="{Binding .}" />
                                </b:Interaction.Behaviors>
                            </wpf1:PlotView>
                        </Grid>
                     </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type scatterPlot:ScatterPlotChartViewModel}">
                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey05Brush}">
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource StandardText}"
                                       Text="{Binding DataPointsCount, StringFormat=Data Points: {0}}" Grid.ZIndex="2"
                                       VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <ContentPresenter Content="{Binding LegendViewModel}" Margin="0,40,5,0" VerticalAlignment="Top" HorizontalAlignment="Right" Grid.ZIndex="2"/>
                            <wpf1:PlotView Model="{Binding PlotModel}">
                                <b:Interaction.Behaviors>
                                    <behavior:ScatterPlotSelectionByDragBehavior ScatterPlotChartViewModel="{Binding .}" />
                                </b:Interaction.Behaviors>
                            </wpf1:PlotView>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate DataType="{x:Type scatterPlot:ScatterPlot2YAxisChartViewModel}">
                <Border BorderThickness="1" BorderBrush="{StaticResource DarkGrey05Brush}">
                    <Grid Background="{StaticResource Anthracite01Brush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource StandardText}"
                                       Text="{Binding DataPointsCount, StringFormat=Data Points: {0}}" Grid.ZIndex="2"
                                       VerticalAlignment="Top" HorizontalAlignment="Right" />
                            <wpf1:PlotView Model="{Binding PlotModel}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0, 0,0,0">
                            <TextBlock Style="{StaticResource StandardText}" Text="Average Band Size:" Margin="5" VerticalAlignment="Center" />
                            <TextBox Style="{StaticResource StandardTextBox}" MinWidth="60" VerticalAlignment="Center"
                                     Text="{Binding AverageBand, Converter={StaticResource DoubleToScalableDecimalsConverter}}"
                                     Margin="5" />
                            <TextBlock Style="{StaticResource StandardText}" Text="{Binding AverageUnits}" Margin="0,5,5,5" VerticalAlignment="Center" />
                            <Button Width="36" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalAlignment="Center"
                                    Command="{Binding RefreshAverageCommand}"
                                    Style="{StaticResource StandardButton}" ToolTip="Refreshes the Average Line.">
                                <Button.Content>
                                    <wpf:ColorAbleIcon Margin="0"
                                                       StrokeBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}, Mode=OneWay}">
                                        <ContentPresenter Margin="15" Content="{StaticResource RefreshIcon}" />
                                    </wpf:ColorAbleIcon>
                                </Button.Content>
                            </Button>
                            <CheckBox IsChecked="{Binding ShowAverage}" Content="Show Average Line" FontSize="{StaticResource NormalFontSize}" Foreground="{StaticResource LightGrey01Brush}" VerticalContentAlignment="Center" Margin="40,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate DataType="{x:Type scatterPlot:LegendItemViewModel}">
                <CheckBox IsChecked="{Binding IsChecked}" >
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="{Binding SeriesColor, Converter={StaticResource ColorDtoToSolidBrushConverter}}" Margin="5,0,5,0" />
                            <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding Title}" />
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </DataTemplate>

            <DataTemplate DataType="{x:Type scatterPlot:LegendViewModel}">
                <Border BorderThickness="1" BorderBrush="{StaticResource DarkRed01Brush}" Background="{StaticResource Anthracite02Brush}" Padding="5" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Expander ExpandDirection="Left" IsExpanded="{Binding IsExpanded}" HorizontalAlignment="Right" HorizontalContentAlignment="Right">
                        <Expander.Content>
                            <ItemsControl ItemsSource="{Binding LegendItems}" />
                        </Expander.Content>
                    </Expander>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>