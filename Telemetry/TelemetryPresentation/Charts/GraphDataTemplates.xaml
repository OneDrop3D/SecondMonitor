<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:graphPanel="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.GraphPanel;assembly=TelemetryApplication"
                    xmlns:wheels="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.GraphPanel.Wheels;assembly=TelemetryApplication"
                    xmlns:chassis="clr-namespace:SecondMonitor.Telemetry.TelemetryApplication.ViewModels.GraphPanel.Chassis;assembly=TelemetryApplication"
                    xmlns:charts="clr-namespace:SecondMonitor.TelemetryPresentation.Charts"
                    xmlns:wpf="http://oxyplot.org/skiawpf"
                    xmlns:wpf1="http://oxyplot.org/wpf">
    <!--<ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../TelemetryPresentation.xaml" />
    </ResourceDictionary.MergedDictionaries>-->

    <Style TargetType="wpf1:TrackerControl">
        <Setter Property="Background" Value="#E0FFFFA0" />
        <Setter Property="Foreground" Value="{StaticResource BlackBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BlackBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="LineStroke" Value="#80000000" />
        <Setter Property="HorizontalLineVisibility" Value="Visible" />
        <Setter Property="VerticalLineVisibility" Value="Visible" />
        <Setter Property="Distance" Value="7" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="ShowPointer" Value="true" />
        <Setter Property="CanCenterHorizontally" Value="true" />
        <Setter Property="CanCenterVertically" Value="true" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="wpf1:TrackerControl">
                    <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Line x:Name="PART_HorizontalLine" Visibility="{TemplateBinding HorizontalLineVisibility}" Stroke="{TemplateBinding LineStroke}" StrokeDashArray="{TemplateBinding LineDashArray}" />
                        <Line x:Name="PART_VerticalLine" Visibility="{TemplateBinding VerticalLineVisibility}" Stroke="{TemplateBinding LineStroke}" StrokeDashArray="{TemplateBinding LineDashArray}" />
                        <Grid x:Name="PART_ContentContainer">
                            <Path x:Name="PART_Path" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="0" />
                            <ContentPresenter x:Name="PART_Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <DataTemplate DataType="{x:Type wheels:LapDetailViewModel}">
        <Grid VerticalAlignment="Stretch" Background="{StaticResource Anthracite01Brush}">
            <DockPanel LastChildFill="False" VerticalAlignment="Top">
                <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource NormalFontSize}" Text="{Binding LapName}" Margin="1" DockPanel.Dock="Top" HorizontalAlignment="Center"/>
                <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding DataInfo}" Margin="1,0,1,0" DockPanel.Dock="Bottom"/>
            </DockPanel>
        </Grid>
    </DataTemplate>
    <DataTemplate DataType="{x:Type wheels:GraphDetailViewModel}">
        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="250">
            <ItemsControl ItemsSource="{Binding LapDetails}"/>
        </ScrollViewer>
    </DataTemplate>
    <DataTemplate x:Key="DefaultGraphDataTemplate" DataType="graphPanel:AbstractSingleSeriesGraphViewModel">
        <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}">
            <Expander IsExpanded="True"  Foreground="{StaticResource LightGrey01Brush}">
                <Expander.Header>
                    <Grid>
                    <DockPanel Margin="0,0,0,0" LastChildFill="False">
                        <TextBlock Margin="0,0,50,0" Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding Title}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <CheckBox Content="Sync With Other Charts"
                                  Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                  IsChecked="{Binding SyncWithOtherGraphs}" VerticalAlignment="Center" DockPanel.Dock="Left" />
                            <TextBlock Margin="50,0,0,0" Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="Display Mode:" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <ComboBox  MinWidth="150" Margin="5,0,0,0" Style="{StaticResource StandardComboBoxStyle}" VerticalAlignment="Center" ItemsSource="{Binding DataExtractors}" SelectedItem="{Binding SelectedDataExtractor}" DockPanel.Dock="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <TextBlock Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding ExtractorName}" Margin="1"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </DockPanel>
                    </Grid>
                </Expander.Header>
                <Grid>
                    <Grid Background="{StaticResource Anthracite01Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock Text="No Data Available" Style="{StaticResource StandardText}"
                                   FontSize="{StaticResource BigFontSize}"
                                   Foreground="{StaticResource DarkRed01Brush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <Grid Background="{StaticResource Anthracite05Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <wpf:PlotView Model="{Binding PlotModel}" Grid.Column="0"/>
                        <ContentPresenter Content="{Binding GraphDetailViewModel}" Grid.Column="1" />
                    </Grid>
                </Grid>
            </Expander>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="WheelsGraphDataTemplate" DataType="wheels:AbstractWheelsGraphViewModel">
        <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}">
            <Expander IsExpanded="True"  Foreground="{StaticResource LightGrey01Brush}">
                <Expander.Header>
                    <Grid>
                        <DockPanel Margin="0,0,0,0" LastChildFill="False">
                            <TextBlock Margin="0,0,50,0" Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding Title}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0, 0,0,0">
                                <CheckBox Content="Sync With Other Charts"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding SyncWithOtherGraphs}" />
                                <CheckBox Content="- Front Left"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="50,0,0,0"
                                          IsChecked="{Binding FrontLeftVisible}" />
                                <CheckBox Content="-Front Right "
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding FrontRightVisible}" />
                                <CheckBox Content="- Rear Left"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding RearLeftVisible}" />
                                <CheckBox Content="- Rear Right"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding RearRightVisible}" />

                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Expander.Header>
                <Grid>
                    <Grid Background="{StaticResource Anthracite01Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock Text="No Data Available" Style="{StaticResource StandardText}"
                                   FontSize="{StaticResource BigFontSize}"
                                   Foreground="{StaticResource DarkRed01Brush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <Grid Background="{StaticResource Anthracite05Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource BooleanToVisibilityConverter}}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <wpf:PlotView Model="{Binding PlotModel}" Grid.Column="0" />
                        <ContentPresenter Content="{Binding GraphDetailViewModel}" Grid.Column="1" />
                    </Grid>
                </Grid>
            </Expander>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="TyreTemperaturesGraphDataTemplate" DataType="wheels:AbstractTyreTemperaturesViewModel">
        <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}">
            <Expander IsExpanded="True" Foreground="{StaticResource LightGrey01Brush}">
                <Expander.Header>
                    <Grid>
                        <DockPanel Margin="0,0,0,0" LastChildFill="False">
                            <TextBlock Margin="0,0,50,0" Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding Title}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Orientation="Horizontal" Margin="0, 0,0,0">
                                <CheckBox Content="Sync With Other Charts"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding SyncWithOtherGraphs}" />
                                <CheckBox Content="- Left"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="50,0,0,0"
                                          IsChecked="{Binding LeftTemperatureVisible}" />
                                <CheckBox Content="- Middle"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding MiddleTemperatureVisible}" />
                                <CheckBox Content="- Right"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding RightTemperatureVisible}" />
                                <CheckBox Content="- Core"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding CoreTemperatureVisible}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Expander.Header>
                <Grid>
                    <Grid Background="{StaticResource Anthracite01Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock Text="No Data Available" Style="{StaticResource StandardText}"
                                   FontSize="{StaticResource BigFontSize}"
                                   Foreground="{StaticResource DarkRed01Brush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <Grid Background="{StaticResource Anthracite05Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <wpf:PlotView Model="{Binding PlotModel}" Grid.Column="0"/>
                            <ContentPresenter Content="{Binding GraphDetailViewModel}" Grid.Column="1"/>
                    </Grid>
                </Grid>
            </Expander>
        </Border>
    </DataTemplate>
    <DataTemplate x:Key="ChassisGraphDataTemplate" DataType="chassis:AbstractChassisGraphViewModel">
        <Border BorderThickness="2" BorderBrush="{StaticResource DarkGrey01Brush}">
            <Expander IsExpanded="True" Foreground="{StaticResource LightGrey01Brush}">
                <Expander.Header>
                    <Grid>
                        <DockPanel Margin="0,0,0,0" LastChildFill="False">
                            <TextBlock Margin="0,0,50,0" Style="{StaticResource StandardText}" FontSize="{StaticResource SmallFontSize}" Text="{Binding Title}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">
                                <CheckBox Content="Sync With Other Charts"
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding SyncWithOtherGraphs}" />
                                <CheckBox Content="Front: "
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="50,0,0,0"
                                          IsChecked="{Binding FrontVisible}" />
                                <CheckBox Content="Rear: "
                                          Foreground="{StaticResource LightGrey01Brush}" Margin="5,0,0,0"
                                          IsChecked="{Binding RearVisible}" />
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                </Expander.Header>
                <Grid>
                    <Grid Background="{StaticResource Anthracite01Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                        <TextBlock Text="No Data Available" Style="{StaticResource StandardText}"
                                   FontSize="{StaticResource BigFontSize}"
                                   Foreground="{StaticResource DarkRed01Brush}" VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <Grid Background="{StaticResource Anthracite05Brush}"
                          Visibility="{Binding HasValidData, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <wpf:PlotView Model="{Binding PlotModel}" Grid.Column="0"/>
                            <ContentPresenter Content="{Binding GraphDetailViewModel}" Grid.Column="1"/>
                        </Grid>
                        <!--<GridSplitter Grid.Row="1" Height="5" Background="{StaticResource DarkGrey01Brush}"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Top" />-->
                    </Grid>
                </Grid>
            </Expander>
        </Border>
    </DataTemplate>
    <charts:GraphDataTemplateSelector x:Key="GraphDataTemplateSelector" DefaultTemplate="{StaticResource DefaultGraphDataTemplate}"
                                      WheelsGraphTemplate="{StaticResource WheelsGraphDataTemplate}" TyreTemperaturesGraphTemplate="{StaticResource TyreTemperaturesGraphDataTemplate}"
                                      ChassisGraphTemplate="{StaticResource ChassisGraphDataTemplate}"/>
    <DataTemplate DataType="{x:Type graphPanel:ChartWrapperViewModel}">
        <Grid>
            <ContentPresenter Content="{Binding ChartViewModel}" ContentTemplateSelector="{StaticResource GraphDataTemplateSelector}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>