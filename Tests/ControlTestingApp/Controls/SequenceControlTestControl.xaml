<UserControl x:Class="ControlTestingApp.Controls.SequenceControlTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ControlTestingApp.ViewModels"
             xmlns:carSystems="clr-namespace:SecondMonitor.WindowsControls.WPF.CarSystems;assembly=WindowsControls"
             xmlns:converters="clr-namespace:SecondMonitor.WindowsControls.WPF.Converters;assembly=WindowsControls"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance Type=viewModels:SequenceViewTestViewModel}">
    <Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="100" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Background="Black" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                <carSystems:VirtualEnergyControl VirtualEnergyPercentage="{Binding Value,  ElementName=FuelLevelSlider}" />
            </Grid>
            <StackPanel Grid.Column="2">
                <Label Foreground="{StaticResource LightGrey01Brush}" Content="Fuel Percentage" />
                <Slider Minimum="0" Maximum="100" x:Name="FuelLevelSlider" />
                <!--<Label Foreground="{StaticResource LightGrey01Brush}" Content="Fuel Left"></Label>
                <Slider TickFrequency="1" Minimum="0" Maximum="60" Value="{Binding FuelLeftRaw}"></Slider>-->
            </StackPanel>
        </Grid>
        <!--Grid Opacity="0.5">
        <Grid.Background>
            <DrawingBrush TileMode="Tile" Viewport="0,0,5,5" Viewbox="0,0,2,2" ViewportUnits="Absolute" ViewboxUnits="Absolute">
                <DrawingBrush.Drawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                                <Pen Thickness="1.5" Brush="{StaticResource LightBlueBrush}" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,1" EndPoint="2,1" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </Grid.Background>
    </Grid>-->
    </Border>

</UserControl>
