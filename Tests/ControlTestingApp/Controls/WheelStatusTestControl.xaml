<UserControl x:Class="ControlTestingApp.Controls.WheelStatusTestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:ControlTestingApp.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <viewModels:WheelStatusTestVm/>
    </UserControl.DataContext>
    <Grid Background="{StaticResource Anthracite05Brush}" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        </Grid>
        <Grid Grid.Column="1">
            <StackPanel>
                <Button Content="Change Temp Units" Height="50" Command="{Binding ChangeTemperatureUnitsCommand}" />
                <Button Content="Change Pressure Units" Height="50" Command="{Binding ChangePressureUnitsCommand}" />
            </StackPanel>
            </Grid>
        <Grid Grid.Column="2">
            <StackPanel>
                <Label Content="Tyre Condition" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider x:Name="ConditionSlider" Value="{Binding TyreCondition}" Minimum="0" Maximum="100" />
                <Label Content="Core Tyre Temperature" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider Value="{Binding TyreCoreRawTemperature, Mode=OneWayToSource}" Minimum="30" Maximum="140" />
                <CheckBox Margin="0,7,0,7" Content="Tyre Slipping" Foreground="{StaticResource LightGrey01Brush}" x:Name="TyreSlipCheckBox" />
                <Label Content="Brake Temperature" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider  Value="{Binding BrakeRawTemperature}" Minimum="0" Maximum="600" />
                <Label Content="Left Tyre" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider  Value="{Binding TyreLeftRawTemperature}" Minimum="0" Maximum="160" />
                <Label Content="Center Tyre" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider  Value="{Binding TyreCenterRawTemperature}" Minimum="0" Maximum="160" />
                <Label Content="Right Tyre" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider  Value="{Binding TyreRightRawTemperature}" Minimum="0" Maximum="160" />
                <Label Content="Tyre Pressure" Foreground="{StaticResource LightGrey01Brush}" />
                <Slider  Value="{Binding TyrePressureRaw}" Minimum="0" Maximum="300" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

