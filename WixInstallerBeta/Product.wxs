    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id ="ApplicationShortcut" Guid="0ad2f58c-8d15-4cb5-bb9e-e45492325e31">
        <Shortcut Id="SecondMonitorShortcut" Target="[!filemyapplication.exe]" Directory="ApplicationProgramsFolder" Name="Second Monitor Beta" WorkingDirectory='APPLICATIONROOTDIRECTORY' Icon="SecondMonitorBeta.exe" Show="normal">
          <Icon Id="SecondMonitorBeta.exe" SourceFile="..\Deployment\SecondMonitorBeta.exe" />
        </Shortcut>
        <Shortcut Id="TelemetryViewerShortCut" Target="[!filetelemetry.exe]" Directory="ApplicationProgramsFolder" Name="Telemetry Viewer Beta" WorkingDirectory='APPLICATIONROOTDIRECTORY' Icon="TelemetryViewerBeta.exe" Show="normal">
          <Icon Id="TelemetryViewerBeta.exe" SourceFile="..\Deployment\TelemetryViewerBeta.exe" />
        </Shortcut>
        <Shortcut Id="ManagePluginsShortCut" Target="[!filemanageplugins.exe]" Directory="ApplicationProgramsFolder" Name="Manage Plugins Beta" WorkingDirectory='APPLICATIONROOTDIRECTORY' Icon="ManagePluginsBeta.exe" Show="normal">
          <Icon Id="ManagePluginsBeta.exe" SourceFile="..\Deployment\ManagePluginsBeta.exe" />
        </Shortcut>
        <RemoveFolder Id="ApplicationProgramsFolder" On="uninstall"/>
        <RegistryValue Root="HKCU" Key="Software\SecondMonitorBeta" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Installation" Level="1">
      <ComponentGroupRef Id="DeploymentGroup" />
      <!--<ComponentRef Id="StartMenuDirectory"/>-->
      <ComponentRef Id="ApplicationShortcut"/>
    </Feature>

    <Property Id="WIXUI_INSTALLDIR" Value="APPLICATIONROOTDIRECTORY" />
    <Property Id="MSIUSEREALADMINDETECTION" Value="1" />

    <UI>
      <UIRef Id="WixUI_InstallDir" />
      <!--<UIRef Id="WixUI_Minimal" />-->
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication">WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed</Publish>
    </UI>

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1"/>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Second Monitor" />

    <Property Id="WixShellExecTarget" Value="[#filemyapplication.exe]" />
    <CustomAction Id="LaunchApplication" BinaryKey="WixCA" DllEntry="WixShellExec" Impersonate="yes" />

  </Product>
